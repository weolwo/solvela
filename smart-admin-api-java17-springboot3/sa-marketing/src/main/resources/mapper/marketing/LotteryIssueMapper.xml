<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.lottery.issue.dao.LotteryIssueDao">

    <resultMap id="LotteryIssueVO" type="net.lab1024.sa.lottery.issue.domain.vo.LotteryIssueVO">
            <result column="id" property="id" />
            <result column="tenant_id" property="tenantId" />
            <result column="lottery_code" property="lotteryCode" />
            <result column="issue_no" property="issueNo" />
            <result column="sold_count" property="soldCount" />
            <result column="sale_start_time" property="saleStartTime" />
            <result column="sale_end_time" property="saleEndTime" />
            <result column="plan_draw_time" property="planDrawTime" />
            <result column="settle_time" property="settleTime" />
            <result column="winning_number" property="winningNumber" />
            <result column="status" property="status" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                tenant_id, 
                lottery_code, 
                issue_no, 
                sold_count, 
                sale_start_time, 
                sale_end_time, 
                plan_draw_time, 
                settle_time, 
                winning_number, 
                status, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.tenantId != null">
                            AND tenant_id = #{queryForm.tenantId}
                        </if>
                        <if test="queryForm.lotteryCode != null">
                            AND lottery_code = #{queryForm.lotteryCode}
                        </if>
                        <if test="queryForm.issueNo != null">
                            AND issue_no = #{queryForm.issueNo}
                        </if>
                        <if test="queryForm.status != null">
                            AND status = #{queryForm.status}
                        </if>
                        <if test="queryForm.createTimeBegin != null">
                            AND create_time &gt;= #{queryForm.createTimeBegin}
                        </if>
                        <if test="queryForm.createTimeEnd != null">
                            AND create_time &lt;= #{queryForm.createTimeEnd}
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="LotteryIssueVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_lottery_issue
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="LotteryIssueVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_lottery_issue
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

                <delete id="batchDelete">
                    delete from t_lottery_issue
                    where id in
                    <foreach collection="idList" open="(" close=")" separator="," item="item">
                        #{item}
                    </foreach>
                </delete>
                <delete id="deleteById">
                    delete from t_lottery_issue
                        where id = #{id}
                </delete>

    <select id="selectDbNow" resultType="java.time.LocalDateTime">
        SELECT NOW()
    </select>

    <!--
        已发数 +1。total_count 挂在 t_lottery_config 上（一个活动可以有多个玩法，
        每个玩法自己的发行规格），所以这里 join 过去取，不在期号表里冗余存一份 ——
        冗余就意味着两处可改、迟早不一致。
        WHERE sold_count < total_count 是防超发的 DB 兜底闸门。
    -->
    <update id="increaseSoldCount">
        UPDATE t_lottery_issue i
        JOIN t_lottery_config c ON c.lottery_code = i.lottery_code
        SET i.sold_count = i.sold_count + 1
        WHERE i.id = #{id}
          AND i.sold_count &lt; c.total_count
    </update>

    <!-- 抢开奖闸门：WHERE status 是并发保护，不是多余条件 -->
    <update id="startSettle">
        UPDATE t_lottery_issue
        SET status = #{to},
            winning_number = #{winningNumber}
        WHERE id = #{id}
          AND status = #{from}
    </update>

    <!--
        核销完成。settle_time 用 NOW() 显式赋值：
        该列没有 ON UPDATE CURRENT_TIMESTAMP 兜底，不写就永远是 NULL。
        用 NOW() 而非 Java 时间，保证全系统仍只有数据库一个时钟（铁律 9）。
    -->
    <update id="finishSettle">
        UPDATE t_lottery_issue
        SET status = #{to},
            settle_time = NOW()
        WHERE id = #{id}
          AND status = #{from}
    </update>

</mapper>
