<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>solvela</groupId>
    <artifactId>solvela-base-mq</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>solvela-base-mq</name>
    <description>基础设施-消息：RabbitMQ 的连接、交换机/队列声明与 JSON 编解码。</description>

    <!--
    <h3>为什么单独一块，而不是塞进 base-core</h3>
    与 data / file 同一个道理：<b>依赖它就等于这个进程要连 RabbitMQ</b>。
    admin 与网关都不需要消息，把 amqp 放进 core 会让它们平白多一个启动期依赖 ——
    而 MQ 连不上时 Spring 默认是<b>启动失败</b>，不是降级。

    <h3>谁会依赖它</h3>
    发奖的两端：marketing（发消息）与 member（收消息）。第三方不要引。
    -->
    <dependencies>

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-core</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!--
        ⚠️ 本模块【只有】拓扑与编解码，没有那张消息记录表。
        记录表（MqMessageLog / MqMessageLogService）在 solvela-base-data 里，因为：
          · 它是一张表加一个 dao，本质是数据层的东西，与 AMQP 无关；
          · 放这里的话，任何想清理这张表的进程（比如跑定时任务的 admin）
            都得跟着背上 amqp —— 而 amqp 一进 classpath，那个进程就想要一个 broker。
        分开之后 admin 只要 base-data 就能清理，不需要连 RabbitMQ。
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!-- 🔴 Spring Boot 4.2 把 4.1 的 spring-boot-starter-amqp 拆成了三个，名字很像、内容完全不同：
                   spring-boot-starter-amqp           → 通用 AMQP 1.0（qpid protonj2），不带 spring-rabbit
                   spring-boot-starter-amqp-rabbitmq  → RabbitMQ 的【AMQP 1.0 客户端】，配置前缀 spring.amqp.rabbitmq
                   spring-boot-starter-rabbitmq       → 经典 RabbitMQ（AMQP 0.9.1：RabbitTemplate / spring.rabbitmq.*）← 本项目用的是这个
                 选错成 amqp-rabbitmq 照样编译通过（它间接带着 RabbitTemplate 这些类），
                 但经典的 Rabbit 自动配置不在里面、spring.rabbitmq.* 没人读 —— 启动时才因为没有 ConnectionFactory 失败。
                 RabbitAutoConfigurationWiringTest 盯着这一条 -->
            <artifactId>spring-boot-starter-rabbitmq</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
