/**
 * @name  活动玩法编排-彩票(样例)
 * @scene ACTIVITY_PLAY
 * @desc  样例脚本：彩票活动「参与一次 = 领一个号」该怎么编排。
 *        真实活动请复制一份改成自己的判据 —— 玩法编码、期号、单人限购都在这里定，
 *        改脚本不用发版，这正是把这段决策放进脚本的原因。
 *
 *        ⚠️ 三条必须守的规矩：
 *        1) lottery_issue 有副作用，一次执行只准调一次，且必须是最后一步。
 *           这个保证是跨函数的 —— 与抽奖函数合计也只准一次，
 *           不存在「先抽一次奖再偷偷领一张票」。
 *        2) 号一旦发出去就收不回来：Redis 游标不随事务回滚
 *           （发重号比浪费一个号严重得多）。所以限购判断必须写在它之前。
 *        3) 发号引擎【不管限购】—— 它的类注释写着「消耗多少积分、单人限购几张，
 *           都由上游业务算完再调进来」。不自己拦的话，一个人能把整期号码领光。
 */

// 非彩票类活动挂错了脚本：返回 null 会被场景契约当成「脚本没有返回值」而报错，
// 报错信息里会点名是哪个脚本 —— 比静默发错东西好得多。
//
// ⚠️ 这条判断对彩票尤其要紧：抽奖脚本和彩票脚本挂在【同一个挂载点】上，
//    后台那一侧长得一模一样，挂错了运营完全看不出来
if (activityType != 'LOTTERY') {
    return null;
}

// 样例配置。真实活动改这两行就行 ——
// 🔴 期号不能省：省了就得由引擎替运营猜「当前是哪一期」，猜错就是发到了别的期上
lotteryCode = 'RMAAUK45TG';
issueNo = '20260918';

// 样例限购：一人一期最多 3 张。
// 🔴 这一段必须在 lottery_issue 之前 —— 号发出去就退不回来了
if (lottery_countMine(lotteryCode, issueNo) >= 3) {
    // 🔴 返回【字符串】= 不发，字符串就是给用户看的那句话，原样显示。
    //    所以这里写的是人话，不是错误码 —— 限购几张、怎么说，都是运营的决定。
    return '本期每人最多领 3 张号码';
}

return lottery_issue(lotteryCode, issueNo);
