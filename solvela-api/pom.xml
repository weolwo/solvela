<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>solvela</groupId>
    <artifactId>solvela-parent</artifactId>
    <version>3.0.0</version>
    <packaging>pom</packaging>

    <name>solvela-api</name>
    <description>solvela project</description>

	<modules>
        <!-- 顺序即依赖方向：上面的不认识下面的。maven 会强制它 —— 写反了直接报循环依赖 -->

        <!-- 全仓共享的枚举与错误码。排在最前是因为它谁也不依赖 ——
             拆出来是为了让将来的 *-api 模块能用枚举，而不必把整个 model（entity + 持久层）拖过去 -->
        <module>solvela-contract</module>
        <module>solvela-model</module>

        <!-- 对外契约：接口 + record，没有实现。粒度对齐【将来的服务】而不是今天的域模块 ——
             会员/资产/提案/优惠配置将来同属 app-member，所以共用一个 api 模块。
             只依赖 contract 与 spring-web，排在 base 之前正是因为它们连基础设施都不需要 -->
        <module>solvela-member-api</module>
        <!-- 会话只用 Redis，单独一块：网关要它（每个请求解析令牌），但网关不能有 JDBC -->
        <module>solvela-member-session</module>
        <module>solvela-marketing-api</module>
        <!-- 技术底座，2026-08-30 拆成四块（+ mq / web 两块给端用）：
             谁都能依赖 core，而 data 意味着 classpath 上有 JDBC 驱动。
             2026-08-31：聚合门面 solvela-base 已删除 —— 每个模块现在列出真正用到的那几块。
             🔴 别再造一个「什么都有」的聚合模块：它是把 JDBC 驱动带上网关、
             把 S3 SDK 和 Excel 引擎带进 C 端两个进程的最短路径，而且写的时候完全无感。 -->
        <module>solvela-base-core</module>
        <module>solvela-base-redis</module>
        <module>solvela-base-data</module>
        <module>solvela-base-file</module>
        <module>solvela-base-mq</module>
        <module>solvela-base-web</module>

        <!-- 业务域。按域拆而不是按"将来谁用"拆：prize 横跨活动侧与资产侧，
             硬塞进任何一端都会造出新的环 -->
        <module>solvela-member</module>
        <module>solvela-scriptengine</module>
        <module>solvela-risk</module>
        <module>solvela-prize</module>
        <module>solvela-ledger</module>

        <!-- 玩法与端。2026-08-31：solvela-activity 与 solvela-consumer 已并入 solvela-marketing ——
             三者的【进程足迹完全相同】（只进 admin 与 C 端业务进程），合并不改变任何进程的 classpath。
             代价是编译器不再拦着 draw/task/lottery 直接调 consumer 的发奖处理器，
             改由 PrizeDispatchBypassTest 断言守着（绕过 PrizeEventPublisher 会让派发跑进事务里）。 -->
        <module>solvela-marketing</module>

        <!-- HTTP 层。刻意排在业务域之后：域模块不认识它，只有端认识。
             2026-08-31：solvela-web 已并入 solvela-admin —— 它只有管理端一个使用方
             （模块外 84 处引用全在 admin），而独立成 artifact 反而是条隐患：
             AppBoundaryTest 的失败提示里写着「多半是有人给 solvela-app 加回了 solvela-web 依赖」，
             不再是独立 artifact 之后，那条路物理上不存在了。
             C 端的 HTTP 薄壳走 solvela-base-web，两套不共用是刻意的（错误码表不同） -->
        <module>solvela-admin</module>
        <!-- 三个进程：admin 1024 / app 1025(网关) / biz 1026。
             端模块只有启动类、HTTP 薄壳与错误出口，业务逻辑一行都不在里面。

             2026-08-31：app-member(1027) 撤销，并入 app-biz（原 app-marketing，因为它装的
             已经不只是营销）。四个进程连的是同一个库，那一刀买不到数据隔离，
             换来的是发奖热路径上一次同步 HTTP 和一条只为回写而存在的 MQ 链路。
             拆服务最贵的是契约，而契约（member-api / marketing-api）原样留着 ——
             将来把资产域拆出去是加回一个进程壳 + 换一个 bean。详见 BizApplication 类注释。 -->
        <module>solvela-app-biz</module>
        <module>solvela-app</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>25</java.version>
        <springboot.version>4.1.0</springboot.version>
        <spring-security-crypto.version>7.1.0</spring-security-crypto.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <p6spy.version>3.9.1</p6spy.version>
        <reflections.version>0.10.2</reflections.version>
        <commons-io.version>2.22.0</commons-io.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <commons-codec.version>1.22.1</commons-codec.version>
        <!-- SonicExcel 的底层引擎（法国人的 org.dhatim:fastexcel，
             和被本轮摘掉的阿里系 cn.idev.excel:fastexcel 毫无关系）。
             读写两个 artifact 从 0.20.0 起统一版本号，一起升。 -->
        <dhatim-fastexcel.version>0.20.2</dhatim-fastexcel.version>
        <awssdk-s3.version>2.50.2</awssdk-s3.version>
        <mysql-connector-j.version>26.7.0</mysql-connector-j.version>
        <velocity-engine-core.version>2.4.1</velocity-engine-core.version>
        <velocity-tools.version>3.1</velocity-tools.version>
        <ip2region.version>3.3.7</ip2region.version>
        <bcprov.version>1.85</bcprov.version>
        <redisson.version>4.6.1</redisson.version>
        <snakeyaml.version>2.6</snakeyaml.version>
        <freemarker.version>2.3.34</freemarker.version>
        <jsoup.version>1.23.1</jsoup.version>
        <tika.version>3.3.2</tika.version>
        <httpcomponents.version>5.6.3</httpcomponents.version>
        <qlexpress.version>4.1.3</qlexpress.version>
        <!-- BOM import 只继承 dependencyManagement 不继承 properties，处理器路径需要显式版本 -->
        <lombok.version>1.18.46</lombok.version>
        <therapi.version>0.15.0</therapi.version>
        <knife4j-baizhukui.version>5.2.1</knife4j-baizhukui.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!--SpringBoot BOM begin-->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${springboot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--SpringBoot BOM end-->
            <!--mybatis-plus BOM begin-->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--mybatis-plus BOM end-->

            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-crypto</artifactId>
                <version>${spring-security-crypto.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector-j.version}</version>
            </dependency>

            <dependency>
                <groupId>p6spy</groupId>
                <artifactId>p6spy</artifactId>
                <version>${p6spy.version}</version>
            </dependency>

            <!-- 使用社区适配 Spring Boot 4.x 的 Knife4j Next 分支，完美恢复 doc.html 体验 -->
            <dependency>
                <groupId>com.baizhukui</groupId>
                <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
                <version>${knife4j-baizhukui.version}</version>
            </dependency>

            <!-- guava 已于 2026-08-06 整体移除：全项目只用到 Lists.newArrayList / Maps.newHashMap /
                 CaseFormat / ThreadFactoryBuilder / Interners 五处，前两者是 JDK 一行等价物，
                 后三者分别换成了 SolvelaCaseFormat、Thread.ofPlatform().factory()、ConcurrentHashMap 规范化锁。
                 省 2.92MB，且它是唯一「除我们自己没人依赖」的工具库 —— 换成自研才真的删得掉 jar。
                 ⚠️ reflections 0.10.2 早已不依赖 guava（依赖树里只有 javassist/jsr305/slf4j），
                 原先挂在它上面的那段 guava exclusion 是历史遗留的空操作，一并删除。 -->
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>${reflections.version}</version>
                <exclusions>
                    <!-- jsr305 是一包只给静态分析工具看的空注解（@Nullable / @Nonnull），没有任何逻辑代码。
                         FindBugs 项目 2012 年就停更（后继者是 SpotBugs），JSR-305 规范本身也一直停在 dormant，
                         而它占着 javax.annotation 包名，和 JDK 的 java.annotation 模块是 split package。
                         本项目一行都没 import 过 javax.annotation.*，reflections 只在自己源码里用它标记参数，
                         注解类运行期缺失时 JVM 静默忽略、不会 NoClassDefFoundError，所以摘掉是安全的。 -->
                    <exclusion>
                        <groupId>com.google.code.findbugs</groupId>
                        <artifactId>jsr305</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>


            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>

            <dependency>
                <artifactId>commons-codec</artifactId>
                <groupId>commons-codec</groupId>
                <version>${commons-codec.version}</version>
            </dependency>

            <!-- ⚠️ 原先挂在这里的 commons-logging exclusion 是空操作，已删除：
                 awssdk v2 全线用 slf4j，2.50.2 的 31 个 pom 里没有任何一个提到 commons-logging，
                 只有早已停更的 v1 才依赖它 —— 和之前那段 guava exclusion 同一个性质的历史遗留。
                 真正有效的 exclusion（netty-nio-client）在 solvela-base/pom.xml 的引入处，
                 因为它的成立前提是「本项目只用同步 S3Client」，属于用法约束而非版本约束。 -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>s3</artifactId>
                <version>${awssdk-s3.version}</version>
            </dependency>


            <!--velocity begin-->
            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity-engine-core</artifactId>
                <version>${velocity-engine-core.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.velocity.tools</groupId>
                <artifactId>velocity-tools-generic</artifactId>
                <version>${velocity-tools.version}</version>
            </dependency>
            <!--velocity end-->


            <!--ip 地址-->
            <dependency>
                <groupId>org.lionsoul</groupId>
                <artifactId>ip2region</artifactId>
                <version>${ip2region.version}</version>
            </dependency>

            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bcprov.version}</version>
            </dependency>

            <!-- SonicExcel 的底层引擎。写端近乎零依赖（只有 27KB 的 opczip）；
                 读端带来 aalto-xml + stax2-api + commons-compress，其中
                 aalto-xml 会通过 META-INF/services 抢占 JVM 全局 StAX 实现，
                 由 SonicStaxIsolation 拨回 JDK 实现，SonicStaxIsolationTest 是哨兵。
                 ⚠️ commons-compress 是 fastexcel-reader 的编译期依赖，摘 POI 时删不掉。 -->
            <dependency>
                <groupId>org.dhatim</groupId>
                <artifactId>fastexcel</artifactId>
                <version>${dhatim-fastexcel.version}</version>
            </dependency>

            <dependency>
                <groupId>org.dhatim</groupId>
                <artifactId>fastexcel-reader</artifactId>
                <version>${dhatim-fastexcel.version}</version>
            </dependency>

            <!-- redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
                <!-- redisson 4.x 起 spring-data 适配已并入本体，原先排除的 redisson-spring-data-32
                     已不存在；actuator 依赖也从 starter 改成了 spring-boot-actuator 本体，排除项跟着改名 -->
                <exclusions>
                    <exclusion>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-actuator</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>

            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>

            <dependency>
                <groupId>org.freemarker</groupId>
                <artifactId>freemarker</artifactId>
                <version>${freemarker.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-core</artifactId>
                <version>${tika.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>${httpcomponents.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>qlexpress4</artifactId>
                <version>${qlexpress.version}</version>
            </dependency>
        </dependencies>

    </dependencyManagement>

    <build>
        <finalName>${project.name}-${profiles.active}-${project.version}</finalName>
        <resources>
            <resource>
                <filtering>false</filtering>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>dev/*</exclude>
                    <exclude>test/*</exclude>
                    <exclude>pre/*</exclude>
                    <exclude>prod/*</exclude>
                </excludes>
            </resource>

            <resource>
                <directory>src/main/resources/${profiles.active}</directory>
                <filtering>true</filtering>
                <includes>
                    <include>*.yaml</include>
                </includes>
            </resource>

            <resource>
                <directory>src/main/resources/${profiles.active}</directory>
                <filtering>false</filtering>
                <includes>
                    <include>*.*</include>
                </includes>
                <!-- 必须排除 *.yaml：上一个 resource 已带 filtering 复制过 yaml，
                     这里若不排除会再用未过滤的原文覆盖，@profiles.active@ 占位符就替换不掉了 -->
                <excludes>
                    <exclude>*.yaml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgument>-parameters</compilerArgument>
                    <source>25</source>
                    <target>25</target>
                    <encoding>UTF-8</encoding>
                    <!-- JDK 23+ javac 默认禁用 classpath 隐式注解处理，Lombok 必须显式声明处理器路径
                    过去：隐式扫描与“白嫖”机制（JDK 22 及以下）在旧版 JDK 中，javac 在编译代码时默认会做一件事：自动去项目的 classpath（即你通过 dependencies 引入的所有 jar 包）里，地毯式搜索是否存在 META-INF/services/javax.annotation.processing.Processor 注册文件。Lombok 恰好在这个路径下注册了自己。因此，只要你在 pom.xml 里引用了 Lombok，javac 就会隐式地自动启动它，为你生成 Get/Set 方法。你不需要做任何额外配置。
                    类似实现了spring aware接口
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!--
                        therapi 把 javadoc 编译进 class 旁边的资源文件，运行时 springdoc 的
                        SpringDocJavadocProvider 读出来当接口文档描述（触发条件是 classpath 上
                        存在 CommentFormatter + springdoc.enable-javadoc 未关）。

                        这不是为了少写注解，是为了让<b>共享层不必依赖 io.swagger</b>：
                        领域对象的字段说明本来就该写在 javadoc 里 —— 那是给读代码的人看的，
                        写两遍（javadoc 一遍、@Schema 一遍）必然有一遍会先过期。

                        ⚠️ 顺序要在 lombok 之后：lombok 生成的 getter 不带 javadoc，
                        therapi 认的是源码里的字段注释，两者互不干扰，但处理器顺序一乱
                        会出现 lombok 尚未展开就被扫描的情况。
                        -->
                        <path>
                            <groupId>com.github.therapi</groupId>
                            <artifactId>therapi-runtime-javadoc-scribe</artifactId>
                            <version>${therapi.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${springboot.version}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--开发环境-->
        <profile>
            <id>dev</id>
            <properties>
                <profiles.active>dev</profiles.active>
            </properties>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
        <!--测试环境-->
        <profile>
            <id>test</id>
            <properties>
                <profiles.active>test</profiles.active>
            </properties>
        </profile>
        <!--预发布环境-->
        <profile>
            <id>pre</id>
            <properties>
                <profiles.active>pre</profiles.active>
            </properties>
        </profile>
        <!--生产环境-->
        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>
            </properties>
        </profile>
    </profiles>

</project>
