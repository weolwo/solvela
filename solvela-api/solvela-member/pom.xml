<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>solvela-member</artifactId>
    <name>solvela-member</name>

    <!--
      会员：身份、实名、登录日志、操作限制。全域的叶子 —— 不引用任何其它业务域。

      【为什么是一个模块，而不是 common-api 里的一个包】
      同一个 jar 里的包之间可以随手互相引用，编译器不拦、code review 也未必看得出来 ——
      风控与账务此前就是这样长出了一个双向环，直到按域拆模块才暴露。
      模块的依赖列表是编译器在守的：本模块的 pom 里没写的东西，这里<b>引不进来</b>。

      <p>另一个看法：将来若真拆成独立服务，这些 dependency 就是那时的 RPC 调用方向。
      现在把方向定对，比那时再来理顺便宜得多。
    -->

    <dependencies>
        <!-- 脚本引擎：MemberScriptFunctions 把会员资料查询以 member_ 域暴露给规则脚本。
             方向是对的 —— scriptengine 是叶子（只依赖 model + base），会员域依赖它不成环。
             反过来把会员函数写进 scriptengine 才是错的：那会让引擎认识每一个业务域 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-scriptengine</artifactId>
            <version>3.0.0</version>
        </dependency>


        <!-- 本模块实现的对外契约。api 在前、实现在后，方向不可反 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 本模块直接用到 model 的实体 15 处。
             原来靠 base 传递过来 —— 用什么就声明什么，别指望别人替你带。 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-model</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 会话存储：冻结会员时要吊销他的全部令牌。会话被拆到独立模块，
             因为网关也要用它而网关不能有 JDBC -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-auth</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 邮件：会员的邮箱验证码（注册/登录/绑定/重置密码）。
             与 admin 共用同一份 MailService 与 t_mail_template ——
             复制一份出去，两处的模板解析、测试环境标题前缀、异常处理迟早不一致 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-mail</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 只依赖真正用到的三块，不写 solvela-base 那个门面 ——
             本模块用的是 base.util / base.domain / base.trace（core）、base.module.redis（redis）、
             base.dao（data）。写门面会顺带把 S3、Excel 引擎、tika、邮件、freemarker 一并背上，
             而会员域一个都不用。这条也是 C 端网关能摘掉那些依赖的前提：
             网关经 solvela-member 传递到什么，就得背什么 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-core</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-redis</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-data</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 通知：账号被限制时告诉用户一声（MemberOperationLimitService）。
             方向是对的 —— notification 排在全部业务域之前，只收 memberId + 参数，
             不反过来认识会员域，不成环 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-notification</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- provided：编译期注解处理器，不进运行包。provided 不传递，每个模块各自声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
