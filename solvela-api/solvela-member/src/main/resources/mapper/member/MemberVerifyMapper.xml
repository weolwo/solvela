<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.member.verify.dao.MemberVerifyDao">

    <!--
      🔴 real_name / id_card 必须挂 typeHandler。
      实体上的 autoResultMap 只对 MyBatis-Plus 自己生成的语句生效，走这份自定义 resultMap
      的查询不吃那个设置 —— 漏了的表现是页面上一片 P1:xxxxx，而且不报任何错。
      （PhysicalDeliveryMapper 上有一模一样的一段注释，那边是先踩了坑才补上的。）

      这里解密出来的是明文，Service 会在下发前脱敏；只有详情接口才把明文放出去。
    -->
    <resultMap id="MemberVerifyDTO" type="solvela.member.verify.domain.dto.MemberVerifyDTO">
        <result column="id" property="id"/>
        <result column="member_id" property="memberId"/>
        <result column="member_name" property="memberName"/>
        <result column="nickname" property="nickname"/>
        <result column="real_name" property="realName"
                typeHandler="solvela.crypto.PiiTypeHandler"/>
        <result column="id_card" property="idCard"
                typeHandler="solvela.crypto.PiiTypeHandler"/>
        <result column="verify_status" property="verifyStatus"/>
        <result column="verify_time" property="verifyTime"/>
        <result column="fail_reason" property="failReason"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!--
      刻意<b>不含 id_card_hash</b>：binary(32) 的内部查重字段，映射成 String 是一串乱码，
      而且它不该离开服务端。
    -->
    <sql id="base_columns">
        v.id,
                v.member_id,
                v.real_name,
                v.id_card,
                v.verify_status,
                v.verify_time,
                v.fail_reason,
                v.create_time,
                v.update_time
    </sql>

    <!--
      账号与昵称走子查询而不是 LEFT JOIN：FROM 里只留一张表，
      MyBatis-Plus 的分页排序（不带表前缀地拼 ORDER BY）就不会撞上 ambiguous
      （create_time / update_time 两张表都有）。
    -->
    <sql id="member_columns">
            (SELECT m.member_name FROM t_member m WHERE m.member_id = v.member_id)
            AS member_name,
                (SELECT m.nickname FROM t_member m WHERE m.member_id = v.member_id) AS nickname
    </sql>

    <sql id="query_conditions">
        <where>
            <if test="queryForm.memberId != null">
                AND v.member_id = #{queryForm.memberId}
            </if>
            <!--
              按账号搜。姓名和身份证是密文，SQL 层<b>没法模糊匹配</b> ——
              真要按姓名找人只能全表解密再比对，那是不可接受的。
              所以这个页面的检索入口只有账号 / 会员号 / 状态 / 时间。
            -->
            <if test="queryForm.memberName != null and queryForm.memberName != ''">
                AND EXISTS (SELECT 1 FROM t_member m
                WHERE m.member_id = v.member_id
                AND m.member_name LIKE CONCAT('%', #{queryForm.memberName}, '%'))
            </if>
            <if test="queryForm.verifyStatus != null">
                AND v.verify_status = #{queryForm.verifyStatus}
            </if>
            <if test="queryForm.createTimeBegin != null">
                AND v.create_time &gt;= #{queryForm.createTimeBegin}
            </if>
            <!--
              🔴 结束日期要用「< 次日零点」，不能用「<= 当天」。
              createTimeEnd 是 LocalDate，绑进 datetime 列是当天 00:00:00 ——
              写成 <= 的话「截止到今天」查不到今天提交的任何一条，而且不报错。
            -->
            <if test="queryForm.createTimeEnd != null">
                AND v.create_time &lt; DATE_ADD(#{queryForm.createTimeEnd}, INTERVAL 1 DAY)
            </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="MemberVerifyDTO">
        SELECT
        <include refid="base_columns"/>,
        <include refid="member_columns"/>
        FROM t_member_verify v
        <include refid="query_conditions"/>
        ORDER BY v.create_time DESC
    </select>

    <select id="queryList" resultMap="MemberVerifyDTO">
        SELECT
        <include refid="base_columns"/>,
        <include refid="member_columns"/>
        FROM t_member_verify v
        <include refid="query_conditions"/>
        ORDER BY v.create_time DESC
    </select>

    <!-- 审核弹窗用：单条、明文。走单独的语句是为了让「下发完整证件号」这件事有唯一入口 -->
    <select id="getDetail" resultMap="MemberVerifyDTO">
        SELECT
        <include refid="base_columns"/>,
        <include refid="member_columns"/>
        FROM t_member_verify v
        WHERE v.id = #{id}
    </select>

</mapper>
