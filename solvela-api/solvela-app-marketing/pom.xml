<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>solvela</groupId>
    <artifactId>solvela-app-marketing</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>solvela-app-marketing</name>
    <description>营销服务：活动、抽奖、任务、彩票、商城、奖品、发奖派发。只对内提供 /internal 接口。</description>

    <!--
    <h3>这是【端】，不是域</h3>
    本模块只有三样东西：启动类、HTTP 薄壳（@RestController implements XxxApi）、错误出口。
    业务逻辑一行都不在这里 —— 它们在 solvela-activity / solvela-marketing / solvela-prize
    那几个域模块里，本模块只是把它们装进一个进程并挂上 HTTP。

    <h3>为什么单独一个模块而不是把启动类塞进 solvela-marketing</h3>
    parent pom 的模块顺序注释写着「HTTP 层刻意排在业务域之后：域模块不认识它，只有端认识」。
    把启动类放进域模块，域就认识 web 栈了，而域模块是要被别的服务复用的。
    -->
    <dependencies>

        <!-- 本服务实现的对外契约 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-marketing-api</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- ================= 装进本进程的域实现 ================= -->

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-activity</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-marketing</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-prize</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!--
        🔴 刻意【没有】 solvela-consumer：发奖派发归 member 服务。

        原本想把它放这里保持「抽奖 → 派发」进程内，但依赖链摊开之后不成立：
            consumer.BalanceHandler → risk.ProposalRecordService → risk.spi.AssetDispatcher
                                                                    ↑ 实现在 solvela-ledger
        而 ledger（资产）属于 member 服务。把 consumer 留在这里，等于把 risk 与 ledger
        也一起拖进营销进程 —— 那样本服务就成了「除 admin 外的全部」，拆了等于没拆。

        所以中奖之后本服务只【发一条消息】，派发在 member 服务那侧完成。
        AssetDispatcher 那个 SPI 的类注释早就写过这一天：
        「这两个域将来若真拆成独立服务，它们之间只能是单向调用或事件」。
        -->

        <!-- 消息：本服务与另一侧靠它连接。拓扑常量与消费幂等都在这个模块里 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-mq</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- ================= HTTP 层 ================= -->

        <!--
        直接依赖 web 栈，不经过 solvela-web —— 那是管理端的 HTTP 层，
        它的 GlobalExceptionHandler 一律返回 200 + ResponseDTO，与本服务的契约冲突。
        本模块自己写错误出口，理由与 solvela-app 相同。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>solvela.marketing.server.MarketingApplication</mainClass>
                    <!-- repackage 默认把 provided 也打进 BOOT-INF/lib，光把 lombok 改成 provided 不够 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
