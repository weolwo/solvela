<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.admin.module.system.table.TableColumnDao">
    <!-- user_type 必须参与过滤：t_table_column 的业务主键是 (user_id, user_type, table_id)。
         员工与会员的 id 各自独立编号，只按 user_id + table_id 定位，
         两种身份下同号的用户会互相覆盖对方保存的表格列。
         DAO 一直传着这个参数，只是 SQL 漏了用。 -->
    <delete id="deleteTableColumn">
        delete
        from t_table_column
        where user_id = #{userId}
          and user_type = #{userType}
          and table_id = #{tableId}
    </delete>
    <select id="selectByUserIdAndTableId"
            resultType="solvela.admin.module.system.table.domain.TableColumnEntity">
        select *
        from t_table_column
        where user_id = #{userId}
          and user_type = #{userType}
          and table_id = #{tableId}
    </select>

</mapper>