<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>solvela-admin</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>solvela-admin</name>
    <description>solvela-admin project</description>

    <dependencies>

        <!-- 本模块直接用到 model 的实体 57 处。
             原来靠 base 传递过来 —— 用什么就声明什么，别指望别人替你带。 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-model</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 管理端的 HTTP 层（solvela.web 包）。2026-08-31 从 solvela-web 模块并进来 ——
             它模块外只有本模块一个使用方，84 处引用全在这里，独立成 artifact 只是多一个
             「能被别人误加」的入口。原模块的两个依赖随之搬到这里。

             ⚠️ 「共享层不认识 HTTP」这条规矩不是靠 solvela-web 独立守住的，而是靠
             base-core/data/file 里没有 spring-boot-starter-web —— 域模块依旧一行
             HttpServletRequest 都编不过，合并前后完全一样。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
        </dependency>

        <!-- 基础设施。2026-08-31 起不再写 solvela-base 那个空门面，四块各自列出 ——
             管理端是唯一四块都真用到的模块（core 33 处 / file 25 处 / data 7 处 / redis 1 处）。
             🔴 刻意【不依赖】 solvela-base-web：本模块是 @ComponentScan("solvela")，
             它里面的 solvela.server.internal.InternalExceptionHandler 会被扫进来，
             变成本进程的第二个 @RestControllerAdvice —— 那正是 AppBoundaryTest
             「只有一个错误出口」那条断言在防的事，只不过方向反过来。
             所以 solvela.web.filter.LogTraceFilter 与 base-web 的 TraceFilter 重复着，
             要合并得先把 InternalExceptionHandler 从被扫描的包里挪走。 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-core</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-redis</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-data</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-file</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-marketing</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 会员/钱包/券/活动/奖品的领域层。此前是靠 solvela-marketing 传递进来的，
             但自从 common-api 的 15 个后台 controller 搬到本模块之后，
             本模块<b>直接</b>依赖了它的 service/form/vo —— 直接用到就直接声明，
             否则哪天 solvela-marketing 不再依赖 common-api，这边会毫无征兆地编译不过。 -->
        <!-- 管理端是全域控制台，七个域都要。这里"全都依赖"是事实而非偷懒 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-ledger</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-prize</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-risk</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-scriptengine</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 本模块大量用 @Data / @Slf4j。lombok 是 provided，不传递，每个模块各自声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- DataScopeSqlConfigService 扫描注解要用；此前是靠 solvela-base 传递白嫖来的，
             而 solvela-base 自己一处没用，已从那边移除 -->
        <dependency>
            <groupId>org.reflections</groupId>
            <artifactId>reflections</artifactId>
        </dependency>

        <!-- 代码生成器渲染 .vm 模板用。随 codegenerator 模块从 solvela-base 移交过来 ——
             全项目只有这一个地方用 velocity，放在 solvela-base 等于让每个依赖它的服务
             都背着这两个 jar，而 C 端进程永远不会生成代码。 -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.velocity.tools</groupId>
            <artifactId>velocity-tools-generic</artifactId>
        </dependency>
        <!-- AdminApplicationTest 需要；此前是靠 solvela-base 的 compile 作用域传递白嫖来的 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>solvela.admin.AdminApplication</mainClass>
                    <!-- repackage 默认会把 provided 作用域也打进 BOOT-INF/lib（为了 servlet-api 之类的场景），
                         所以光把 lombok 改成 provided 不够，这里还要显式排掉。
                         spring-boot-starter-parent 自带这条默认配置，本项目走 BOM import 没有继承到。 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 生产包：把整套 API 文档依赖排出 BOOT-INF/lib（约 5.9MB）。
             注意这是 repackage 阶段的排除，编译期这些 jar 仍在 classpath 上，
             所以 SwaggerConfig / SchemaEnumPropertyCustomizer 照常编译，只是不进生产包。

             运行期安全性由两处条件保证：
               · SwaggerConfig     —— @Conditional(SystemEnvironmentConfig.class)，只在 dev/test 装配
               · SchemaEnumPropertyCustomizer —— @ConditionalOnClass(PropertyCustomizer.class)
             prod/solvela-base.yaml 里的三个 enabled:false 是第三道保险。

             ⚠️ 故意保留的两个：
               · io.swagger.core.v3:swagger-annotations-jakarta（28KB）——
                 全项目 312 处 @Schema / 72 处 @Operation / 71 处 @Tag 都是 RUNTIME 保留，
                 注解类缺失时 JVM 虽会静默跳过，但任何走 getAnnotations() 的反射路径都可能
                 抛 TypeNotPresentException。省这 28KB 不值当。
               · com.fasterxml.jackson.core:jackson-annotations —— swagger-annotations 的依赖，同理。
             Jackson 2 的其余部分（core/databind/yaml/jsr310）唯一来源就是 swagger-core-jakarta，
             已用 dependency:tree -Dverbose 核实过，随文档一起排掉是安全的。 -->
        <profile>
            <id>prod</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>solvela.admin.AdminApplication</mainClass>
                            <excludes>
                                <exclude>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </exclude>
                                <!-- knife4j -->
                                <exclude>
                                    <groupId>com.baizhukui</groupId>
                                    <artifactId>knife4j-core</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.baizhukui</groupId>
                                    <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.baizhukui</groupId>
                                    <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.baizhukui</groupId>
                                    <artifactId>knife4j-openapi3-ui</artifactId>
                                </exclude>
                                <!-- springdoc + swagger -->
                                <exclude>
                                    <groupId>org.springdoc</groupId>
                                    <artifactId>springdoc-openapi-starter-common</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>org.springdoc</groupId>
                                    <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>org.springdoc</groupId>
                                    <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>org.webjars</groupId>
                                    <artifactId>swagger-ui</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>io.swagger.core.v3</groupId>
                                    <artifactId>swagger-core-jakarta</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>io.swagger.core.v3</groupId>
                                    <artifactId>swagger-models-jakarta</artifactId>
                                </exclude>
                                <!-- Jackson 2：唯一来源是 swagger-core-jakarta，跟着一起走 -->
                                <exclude>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-core</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-databind</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                                    <artifactId>jackson-dataformat-yaml</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.fasterxml.jackson.datatype</groupId>
                                    <artifactId>jackson-datatype-jsr310</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>