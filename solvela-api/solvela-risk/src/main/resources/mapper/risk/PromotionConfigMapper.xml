<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.risk.promotionconfig.dao.PromotionConfigDao">

    <resultMap id="PromotionConfigVO" type="solvela.risk.promotionconfig.domain.vo.PromotionConfigVO">
        <result column="id" property="id"/>
        <result column="promo_name" property="promoName"/>
        <result column="prize_type" property="prizeType"/>
        <result column="total_quota" property="totalQuota"/>
        <result column="used_quota" property="usedQuota"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="used_amount" property="usedAmount"/>
        <result column="review_level" property="reviewLevel"/>
        <result column="first_review_threshold" property="firstReviewThreshold"/>
        <result column="second_review_threshold" property="secondReviewThreshold"/>
        <result column="single_max_quota" property="singleMaxQuota"/>
        <result column="single_max_amount" property="singleMaxAmount"/>
        <result column="limit_period" property="limitPeriod"/>
        <result column="identify_limit" property="identifyLimit"/>
        <result column="phone_limit" property="phoneLimit"/>
        <result column="ip_limit" property="ipLimit"/>
        <result column="device_limit" property="deviceLimit"/>
        <result column="fingerprint_limit" property="fingerprintLimit"/>
        <result column="mutex_rule" property="mutexRule"/>
        <result column="status" property="status"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="base_columns">
        id,
                promo_name, 
                prize_type, 
                total_quota, 
                used_quota, 
                total_amount, 
                used_amount, 
                review_level, 
                first_review_threshold, 
                second_review_threshold, 
                single_max_quota, 
                single_max_amount, 
                limit_period, 
                identify_limit, 
                phone_limit, 
                ip_limit, 
                device_limit, 
                fingerprint_limit, 
                mutex_rule, 
                status, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
            <if test="queryForm.promoName != null">
                AND promo_name = #{queryForm.promoName}
            </if>
            <if test="queryForm.prizeType != null">
                AND prize_type = #{queryForm.prizeType}
            </if>
            <if test="queryForm.createTimeBegin != null">
                AND create_time &gt;= #{queryForm.createTimeBegin}
            </if>
            <if test="queryForm.createTimeEnd != null">
                <!-- 结束日含当天：这里是 LocalDate，绑进来是当天零点，写 &lt;= 会把结束日整天静默筛掉 -->
                AND create_time &lt; DATE_ADD(#{queryForm.createTimeEnd}, INTERVAL 1 DAY)
            </if>
            <if test="queryForm.identifyLimit != null">
                AND identify_limit = #{queryForm.identifyLimit}
            </if>
            <if test="queryForm.phoneLimit != null">
                AND phone_limit = #{queryForm.phoneLimit}
            </if>
            <if test="queryForm.ipLimit != null">
                AND ip_limit = #{queryForm.ipLimit}
            </if>
            <if test="queryForm.status != null">
                AND status = #{queryForm.status}
            </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="PromotionConfigVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_promotion_config
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="PromotionConfigVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_promotion_config
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <delete id="batchDelete">
        delete from t_promotion_config
        where id in
        <foreach collection="idList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </delete>
    <delete id="deleteById">
        delete
        from t_promotion_config
        where id = #{id}
    </delete>

    <!--
      预算原子预扣：判断与扣减放在同一条 UPDATE 里，靠行锁保证并发下不会超发。
      -1 表示不限制，条件直接为真。
    -->
    <update id="deductBudget">
        update t_promotion_config
        set used_amount = used_amount + #{amount},
            used_quota  = used_quota + #{quota}
        where id = #{id}
          and (total_amount = -1 or total_amount - used_amount &gt;= #{amount})
          and (total_quota = -1 or total_quota - used_quota &gt;= #{quota})
    </update>

    <!-- 预扣回滚：CASE WHEN 兜底，避免并发下被扣成负数 -->
    <update id="releaseBudget">
        update t_promotion_config
        set used_amount = case when used_amount &gt;= #{amount} then used_amount - #{amount} else 0 end,
            used_quota  = case when used_quota &gt;= #{quota} then used_quota - #{quota} else 0 end
        where id = #{id}
    </update>

</mapper>