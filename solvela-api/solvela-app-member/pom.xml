<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>solvela</groupId>
    <artifactId>solvela-app-member</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>solvela-app-member</name>
    <description>会员服务：会员与会话、资产、提案与优惠配置、发奖派发。只对内提供 /internal 接口。</description>

    <!--
    与 solvela-app-marketing 同构：本模块只有启动类、HTTP 薄壳、错误出口，业务逻辑一行都不在这里。

    <h3>🔴 这里没有 prize，也没有 consumer</h3>
    发奖流水（t_prize_log）是<b>营销侧的账</b>，读写它的 consumer 也就归营销。
    本服务只负责「收下一笔奖」这一段：风控过滤 → 生成提案 → 资产入账。

    <p>于是发奖被切成两段，方向相反：
    <ul>
      <li>营销 →(同步 HTTP)→ 本服务：MemberProposalApi，当场返回受理/拒绝+原因；</li>
      <li>本服务 →(异步消息)→ 营销：资产真正入账的结果，落发奖流水的终态。</li>
    </ul>
    这正是 AssetDispatcher 那个 SPI 的类注释预言的形态：
    「这两个域将来若真拆成独立服务，它们之间只能是单向调用或事件」。
    -->
    <dependencies>

        <!-- 本服务实现的对外契约 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member-api</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- ================= 装进本进程的域实现 ================= -->

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 资产：钱包、券、实物履约、动账流水 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-ledger</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 风控与提案。⚠️ 本模块横跨两个服务：proposal 在这一侧，
             而 promotionconfig（优惠配置）被营销侧的奖品配置引用着。
             真要拆库之前，这个模块得先按归属拆开 —— 已记在方案的债里 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-risk</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 消息：本服务与另一侧靠它连接。拓扑常量与消费幂等都在这个模块里 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-mq</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- ================= HTTP 层 ================= -->

        <!-- 链路 id 过滤器 + 服务间调用的错误出口（两者在两个包根下，见该模块 pom 的说明） -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-web</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 直接依赖 web 栈，不经过 solvela-web（那是管理端的 HTTP 层，
             它的 GlobalExceptionHandler 一律返回 200 + ResponseDTO，与本服务的契约冲突） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>solvela.member.server.MemberApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
