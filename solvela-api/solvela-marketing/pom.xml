<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>solvela-marketing</artifactId>

    <!-- 编译等级与编码跟随父 pom（java.version=25，compiler-plugin 显式 source/target=25）。
         此处原先声明 maven.compiler.source/target=17，但父 pom 的 compiler-plugin 里是硬编码的 25，
         插件显式配置优先于属性 —— 那三行从来没生效过，只会让人误以为本模块限制在 17。
         抽奖引擎用到的 switch 模式匹配需要 21+，实际正是靠 25 才编得过。 -->

    <dependencies>

        <!-- 把抽奖暴露成脚本函数（DrawScriptFunctions）。只用到 @ScriptFunction 与 SPI，
             不自己执行脚本 —— 执行入口在活动域 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-scriptengine</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 本模块实现 DrawApi。虽然经 solvela-activity 也能传递拿到，
             但用什么就声明什么 —— 别指望别人替你带 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-marketing-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 活动系统的依赖边界：只有这三个域。刻意<b>没有</b>
             risk / consumer / scriptengine / ledger —— pom 里没写就引不进来，
             这比「约定不要引」可靠。

             曾经这里还有一条 solvela-ledger，因为 DrawExecuteService 里挂着一行
             {@code import MemberWalletService}。查下去发现<b>那行根本没被用到</b> ——
             活动系统事实上一直是无状态的，只是一个未使用的 import 让整个模块
             白背了一个域的依赖。删掉它，边界就与设计一致了。

             ⚠️ 将来活动要发资产，走事件或 SPI（参考 risk.spi.AssetDispatcher），
             不要把这条依赖加回来。 -->
        <!-- 本模块直接用到 model 的实体 135 处。
             原来靠 base 传递过来 —— 用什么就声明什么，别指望别人替你带。 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-model</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 本模块直接用到 base 的 111 处（ResponseDTO、PageResult、各种 Util）。
             原来靠传递依赖拿到 —— 一旦上游模块调整，这里会在毫不相关的地方成片编译失败。 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-activity</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-prize</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- provided：编译期注解处理器，不进运行包。provided 不传递，每个模块各自声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 本模块有单测（draw/lottery 引擎共 45 个），必须自己声明；
             此前是靠 common-api → solvela-base 的 compile 作用域传递白嫖来的 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>