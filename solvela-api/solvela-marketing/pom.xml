<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>solvela-marketing</artifactId>

    <!-- 编译等级与编码跟随父 pom（java.version=25，compiler-plugin 显式 source/target=25）。
         此处原先声明 maven.compiler.source/target=17，但父 pom 的 compiler-plugin 里是硬编码的 25，
         插件显式配置优先于属性 —— 那三行从来没生效过，只会让人误以为本模块限制在 17。
         抽奖引擎用到的 switch 模式匹配需要 21+，实际正是靠 25 才编得过。 -->

    <dependencies>

        <!-- 把抽奖暴露成脚本函数（DrawScriptFunctions）。只用到 @ScriptFunction 与 SPI，
             不自己执行脚本 —— 执行入口在活动域 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-scriptengine</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 本模块实现 DrawApi。虽然经 solvela-activity 也能传递拿到，
             但用什么就声明什么 —— 别指望别人替你带 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-marketing-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 🔴 依赖边界：这里【没有】 solvela-ledger，将来也不要加回来。

             曾经有过一条，因为 DrawExecuteService 里挂着一行未被使用的
             {@code import MemberWalletService} —— 一个死 import 让整个模块白背了一个域。

             这条边界现在比以前重要：资产域（ledger）是将来要独立出去的那个服务，
             marketing ↔ ledger 就是那条缝。要发资产只能经 {@code MemberProposalApi}，
             由 MarketingLedgerBoundaryTest 断言守着（它同时守着 risk.proposal）。

             2026-08-31 合并进来的 solvela-risk 是给 consumer 用的，而且只该用到
             promotionconfig / promotiongroup 那半边；proposal 那半边属于资产侧。 -->
        <!-- 本模块直接用到 model 的实体 135 处。
             原来靠 base 传递过来 —— 用什么就声明什么，别指望别人替你带。 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-model</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 基础设施。2026-08-31 起不再写 solvela-base 那个空门面（0 行代码），
             改成列出真正用到的那几块 —— 写门面等于把 JDBC 驱动、S3 SDK、Excel 引擎一并背上。
             归因：core 13 处、file 2 处、data 1 处；本模块有 22 个 Mapper.xml，是全仓最重的域模块。
             不要 redis：一处都没用到 —— 分布式锁走的是各自进程里已有的 RedisLockAspect -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-core</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-data</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-file</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-prize</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 以下两条随 solvela-consumer 于 2026-08-31 并入本模块：
             发奖要把奖交给资产侧 —— 同步调 MemberProposalApi 拿「受理 / 拒绝 + 原因」。
             🔴 这是本模块碰资产的【唯一】合法途径 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- consumer 的 ProposalSourceResolver / PrizeStrategyFactory 用到 risk 的枚举与 spi -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-risk</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- provided：编译期注解处理器，不进运行包。provided 不传递，每个模块各自声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 本模块有单测（draw/lottery 引擎共 45 个），必须自己声明；
             此前是靠 common-api → solvela-base 的 compile 作用域传递白嫖来的 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>