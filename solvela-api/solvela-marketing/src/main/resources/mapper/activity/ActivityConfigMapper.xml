<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.activity.dao.ActivityConfigDao">

    <resultMap id="ActivityConfigDTO" type="solvela.activity.domain.dto.ActivityConfigDTO">
        <result column="id" property="id"/>
        <result column="activity_code" property="activityCode"/>
        <result column="activity_name" property="activityName"/>
        <result column="activity_type" property="activityType"/>
        <result column="status" property="status"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="base_columns">
        id,
                activity_code, 
                activity_name, 
                activity_type, 
                status, 
                start_time, 
                end_time, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
            <if test="queryForm.activityCode != null">
                AND activity_code = #{queryForm.activityCode}
            </if>
            <if test="queryForm.activityName != null">
                AND activity_name = #{queryForm.activityName}
            </if>
            <if test="queryForm.createTimeBegin != null">
                AND create_time &gt;= #{queryForm.createTimeBegin}
            </if>
            <if test="queryForm.createTimeEnd != null">
                <!-- 结束日含当天：这里是 LocalDate，绑进来是当天零点，写 &lt;= 会把结束日整天静默筛掉 -->
                AND create_time &lt; DATE_ADD(#{queryForm.createTimeEnd}, INTERVAL 1 DAY)
            </if>
            <if test="queryForm.activityType != null">
                AND activity_type = #{queryForm.activityType}
            </if>
            <if test="queryForm.status != null">
                AND status = #{queryForm.status}
            </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="ActivityConfigDTO">
        SELECT
        <include refid="base_columns"/>
        FROM t_activity_config
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="ActivityConfigDTO">
        SELECT
        <include refid="base_columns"/>
        FROM t_activity_config
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <!--
      ==================== 状态闸门 ====================

      🔴 每条改状态的 UPDATE 带旧状态条件，是 ActivityStatusEnum#canTransitTo 的边，
      ActivityConfigStatusSqlTest 断言一一对应。状态值写成 ${@...@X.value}，${} 里只放常量。
      删除只认未开始：上过线的活动删掉等于把发奖流水的追溯链断在源头，
      ActivityConfigService#checkDeletable 是先读后判，这里压进 WHERE 兜住读与删之间被人上线的情况。
    -->
    <update id="markOnline">
        update t_activity_config
        set status = ${@solvela.enums.ActivityStatusEnum@ONLINE.value}
        where id = #{id}
          and status in (${@solvela.enums.ActivityStatusEnum@NOT_START.value}, ${@solvela.enums.ActivityStatusEnum@OFFLINE.value})
    </update>

    <update id="markOffline">
        update t_activity_config
        set status = ${@solvela.enums.ActivityStatusEnum@OFFLINE.value}
        where id = #{id}
          and status in (${@solvela.enums.ActivityStatusEnum@NOT_START.value}, ${@solvela.enums.ActivityStatusEnum@ONLINE.value})
    </update>

    <delete id="deleteNotStarted">
        delete from t_activity_config
        where id = #{id}
          and status = ${@solvela.enums.ActivityStatusEnum@NOT_START.value}
    </delete>

    <delete id="deleteNotStartedBatch">
        delete from t_activity_config
        where status = ${@solvela.enums.ActivityStatusEnum@NOT_START.value}
          and id in
        <foreach collection="idList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </delete>

</mapper>