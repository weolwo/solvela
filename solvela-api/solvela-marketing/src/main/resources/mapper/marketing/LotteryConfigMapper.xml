<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.lottery.config.dao.LotteryConfigDao">

    <resultMap id="LotteryConfigDTO" type="solvela.lottery.config.domain.dto.LotteryConfigDTO">
            <result column="id" property="id" />
            <result column="activity_code" property="activityCode" />
            <result column="lottery_code" property="lotteryCode" />
            <result column="lottery_name" property="lotteryName" />
            <result column="number_charset" property="numberCharset" />
            <result column="number_length" property="numberLength" />
            <result column="total_count" property="totalCount" />
            <result column="status" property="status" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                activity_code, 
                lottery_code, 
                lottery_name, 
                number_charset, 
                number_length, 
                total_count, 
                status, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.activityCode != null">
                            AND activity_code = #{queryForm.activityCode}
                        </if>
                        <if test="queryForm.lotteryCode != null">
                            AND lottery_code = #{queryForm.lotteryCode}
                        </if>
                        <if test="queryForm.lotteryName != null">
                            AND lottery_name = #{queryForm.lotteryName}
                        </if>
                        <if test="queryForm.status != null">
                            AND status = #{queryForm.status}
                        </if>
                        <if test="queryForm.createTimeBegin != null">
                            AND create_time &gt;= #{queryForm.createTimeBegin}
                        </if>
                        <if test="queryForm.createTimeEnd != null">
                            <!-- 结束日含当天：这里是 LocalDate，绑进来是当天零点，写 &lt;= 会把结束日整天静默筛掉 -->
                            AND create_time &lt; DATE_ADD(#{queryForm.createTimeEnd}, INTERVAL 1 DAY)
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="LotteryConfigDTO">
        SELECT
        <include refid="base_columns"/>
        FROM t_lottery_config
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="LotteryConfigDTO">
        SELECT
        <include refid="base_columns"/>
        FROM t_lottery_config
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <!-- 状态条件流转：WHERE status = #{from} 是并发闸门，不是多余条件 -->
    <update id="updateStatus">
        UPDATE t_lottery_config
        SET status = #{to}
        WHERE id = #{id}
          AND status = #{from}
    </update>

</mapper>
