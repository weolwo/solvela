<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.mall.sku.dao.MallSkuDao">

    <resultMap id="MallSkuVO" type="solvela.mall.sku.domain.vo.MallSkuVO">
            <result column="id" property="id" />
            <result column="commodity_id" property="commodityId" />
            <result column="commodity_name" property="commodityName" />
            <result column="commodity_code" property="commodityCode" />
            <result column="cover_file_id" property="coverFileId" />
            <result column="commodity_status" property="commodityStatus" />
            <result column="base_points_price" property="basePointsPrice" />
            <result column="category_id" property="categoryId" />
            <result column="category_name" property="categoryName" />
            <result column="sku_code" property="skuCode" />
            <result column="sku_attrs" property="skuAttrs" />
            <result column="sku_cover_file_id" property="skuCoverFileId" />
            <result column="sku_points_price" property="skuPointsPrice" />
            <result column="sku_cash_price" property="skuCashPrice" />
            <result column="total_stock" property="totalStock" />
            <result column="locked_stock" property="lockedStock" />
            <result column="sold_count" property="soldCount" />
            <result column="available_stock" property="availableStock" />
            <result column="sku_status" property="skuStatus" />
            <result column="sort" property="sort" />
            <result column="create_time" property="createTime" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                s.id,
                s.commodity_id,
                s.sku_code,
                s.sku_attrs,
                s.sku_cover_file_id,
                s.sku_points_price,
                s.sku_cash_price,
                s.total_stock,
                s.locked_stock,
                s.sold_count,
                s.available_stock,
                s.sku_status,
                s.sort,
                s.create_time,
                s.update_time
    </sql>

    <!-- 商品信息：只看 SKU 编码认不出这是哪个商品的哪个规格 -->
    <sql id="commodity_columns">
                c.commodity_name    AS commodity_name,
                c.commodity_code    AS commodity_code,
                c.cover_file_id     AS cover_file_id,
                c.status            AS commodity_status,
                c.points_price      AS base_points_price,
                c.category_id       AS category_id,
                (SELECT cat.category_name FROM t_mall_category cat WHERE cat.id = c.category_id) AS category_name
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.commodityName != null and queryForm.commodityName != ''">
                            AND c.commodity_name LIKE CONCAT('%', #{queryForm.commodityName}, '%')
                        </if>
                        <if test="queryForm.commodityCode != null and queryForm.commodityCode != ''">
                            AND c.commodity_code = #{queryForm.commodityCode}
                        </if>
                        <if test="queryForm.skuCode != null and queryForm.skuCode != ''">
                            AND s.sku_code = #{queryForm.skuCode}
                        </if>
                        <if test="queryForm.categoryId != null">
                            AND c.category_id = #{queryForm.categoryId}
                        </if>
                        <if test="queryForm.skuStatus != null">
                            AND s.sku_status = #{queryForm.skuStatus}
                        </if>
                        <if test="queryForm.commodityStatus != null">
                            AND c.status = #{queryForm.commodityStatus}
                        </if>
                        <!--
                          可用库存是数据库的虚拟列，可以直接进 WHERE（它不是聚合值）。
                          走这个条件时 MySQL 用不上索引，但库存总览本来就是全量扫一遍找低库存的，
                          而 SKU 的量级是「商品数 × 规格数」，几千行以内，可以接受。
                        -->
                        <if test="queryForm.stockBelow != null">
                            AND s.available_stock &lt;= #{queryForm.stockBelow}
                        </if>
        </where>
    </sql>

    <!--
      默认按可用库存升序：这个页面打开就是为了看「哪些快卖光了」，
      按创建时间排的话最该看的那几行会淹在几百行中间。
      停用的规格排到最后 —— 它们本来就不卖，缺不缺货不重要。
    -->
    <select id="queryPage" resultMap="MallSkuVO">
        SELECT
        <include refid="base_columns"/>,
        <include refid="commodity_columns"/>
        FROM t_mall_sku s
        INNER JOIN t_mall_commodity c ON c.id = s.commodity_id
        <include refid="query_conditions"/>
        ORDER BY s.sku_status DESC, s.available_stock ASC, s.id ASC
    </select>

    <select id="queryList" resultMap="MallSkuVO">
        SELECT
        <include refid="base_columns"/>,
        <include refid="commodity_columns"/>
        FROM t_mall_sku s
        INNER JOIN t_mall_commodity c ON c.id = s.commodity_id
        <include refid="query_conditions"/>
        ORDER BY s.sku_status DESC, s.available_stock ASC, s.id ASC
    </select>


</mapper>