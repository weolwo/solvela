<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.task.record.dao.TaskRecordDao">

    <resultMap id="TaskRecordDTO" type="solvela.task.record.domain.dto.TaskRecordDTO">
            <result column="id" property="id" />
            <result column="member_id" property="memberId" />
            <result column="member_name" property="memberName" />
            <result column="task_config_id" property="taskConfigId" />
            <result column="activity_code" property="activityCode" />
            <result column="period_key" property="periodKey" />
            <result column="valid_start_time" property="validStartTime" />
            <result column="valid_end_time" property="validEndTime" />
            <result column="current_metric" property="currentMetric" />
            <result column="status" property="status" />
            <result column="progress_data" property="progressData" />
            <result column="rule_snapshot" property="ruleSnapshot" />
            <result column="prize_snapshot" property="prizeSnapshot" />
            <result column="complete_time" property="completeTime" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                member_id, 
                task_config_id, 
                activity_code, 
                period_key, 
                valid_start_time, 
                valid_end_time, 
                current_metric, 
                status, 
                progress_data, 
                rule_snapshot, 
                prize_snapshot, 
                complete_time, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <!--
        漏斗统计的筛选条件：与列表共用同一批条件，但<b>刻意不吃 status 与 completeTime</b>。
        那两个正是漏斗要拆解的维度 ——
          · 跟着 status 筛，点「只看已发奖」之后漏斗会变成「达标率 100%」；
          · completeTime 只有达标的记录才有值，跟着它筛等于先把进行中/已过期的行全删掉，
            达标率同样恒为 100%。
        几个数字互相之间就没法对照了，而这正是漏斗存在的意义。

        ⚠️ 不套 &lt;where&gt;，只给裸条件片段：丢弃分布那条查询还要在同一个 &lt;where&gt; 里
        追加 flow_type=2，本片段自带 &lt;where&gt; 会让追加的条件落在外面，
        而所有筛选项为空时还会拼出一句悬空的 AND。由调用方各自套。
    -->
    <sql id="funnel_conditions">
        <if test="queryForm.memberId != null">
            AND member_id = #{queryForm.memberId}
        </if>
        <if test="queryForm.activityCode != null">
            AND activity_code = #{queryForm.activityCode}
        </if>
        <if test="queryForm.validStartTimeBegin != null">
            AND valid_start_time &gt;= #{queryForm.validStartTimeBegin}
        </if>
        <if test="queryForm.validStartTimeEnd != null">
            <!-- 结束日含当天：这里是 LocalDate，绑进来是当天零点，写 &lt;= 会把结束日整天静默筛掉 -->
            AND valid_start_time &lt; DATE_ADD(#{queryForm.validStartTimeEnd}, INTERVAL 1 DAY)
        </if>
    </sql>

    <!--
        漏斗计数 + 过期收口体检 + 一致性体检，一次扫表算完。
        不拆成多条 count：多次执行不但慢，还可能落在不同数据快照上，
        出现「分项加起来不等于总数」这种自相矛盾。

        staleRunningCount 是本页最该被盯住的数字：全工程没有任何地方把 status 改成 3-已过期
        （idx_t_tsk_rec_expire(status, valid_end_time) 就是给那个扫描建的，但扫描没写），
        这些记录不会自己收口，用户端会一直看到一个永远完不成的任务。

        末尾四个是数据一致性检查（本页的 add/update 还在，人工改坏是有路径的）：
          - reachedNoCompleteTime  ：达标了却没有达标时间，客诉时说不清是哪天完成的
          - runningWithCompleteTime：进行中却带着达标时间，与 status 自相矛盾
          - reachedNoPrizeSnapshot ：达标了但奖励快照是空数组，即「任务压根没配奖励」，达标也没奖可发
          - noRuleSnapshot         ：规则快照为空（"{}"），策略层读不到目标值，这条记录永远不会达标

        ⚠️ rule_snapshot / prize_snapshot 是 JSON 列，不能写 `= ''`（MySQL 会按 JSON 解析空串直接报错），
        判空一律用 JSON_LENGTH：'{}' 与 '[]' 都是 0。
    -->
    <select id="selectFunnel" resultType="java.util.Map">
        SELECT
            COUNT(*)                                                      AS totalCount,
            COUNT(DISTINCT member_id)                                     AS memberCount,
            COALESCE(SUM(status = 0), 0)                                  AS runningCount,
            COALESCE(SUM(status = 1), 0)                                  AS completedCount,
            COALESCE(SUM(status = 2), 0)                                  AS dispatchedCount,
            COALESCE(SUM(status = 3), 0)                                  AS expiredCount,
            COALESCE(SUM(status = 0 AND valid_end_time &lt; now()), 0)    AS staleRunningCount,
            COALESCE(SUM(status IN (1, 2) AND complete_time IS NULL), 0)  AS reachedNoCompleteTime,
            COALESCE(SUM(status = 0 AND complete_time IS NOT NULL), 0)    AS runningWithCompleteTime,
            COALESCE(SUM(status IN (1, 2)
                     AND (prize_snapshot IS NULL OR JSON_LENGTH(prize_snapshot) = 0)), 0) AS reachedNoPrizeSnapshot,
            COALESCE(SUM(rule_snapshot IS NULL OR JSON_LENGTH(rule_snapshot) = 0), 0)     AS noRuleSnapshot
        FROM t_task_record
        <where><include refid="funnel_conditions"/></where>
    </select>

    <!--
        任务维度分布：哪个任务接得多、哪个任务没人做得完。
        LIMIT 20 是刻意的 —— 前 20 之后的长尾在页面上只会挤成一片，要全量请走导出。
    -->
    <select id="selectTaskStat" resultType="java.util.Map">
        SELECT task_config_id                                          AS taskConfigId,
               COUNT(*)                                                AS recordCount,
               COUNT(DISTINCT member_id)                               AS memberCount,
               COALESCE(SUM(status IN (1, 2)), 0)                      AS reachedCount,
               COALESCE(SUM(status = 0 AND valid_end_time &lt; now()), 0) AS staleRunningCount
        FROM t_task_record
        <where><include refid="funnel_conditions"/></where>
        GROUP BY task_config_id
        ORDER BY recordCount DESC
        LIMIT 20
    </select>

    <!--
        事件丢弃分类分布。查的是流水表而不是记录表：被丢弃的事件压根没建记录
        （人群不符、配置异常、线程池打满都发生在建记录之前），记录表怎么翻都看不到它们。
        走 idx_t_tsk_flw_stat(create_time, flow_type, discard_code)。

        筛选条件只挑流水表<b>确实有</b>的那几列对齐：
          · member_id 直接对应；
          · activity_code 流水表没有，经 task_config_id 关联配置表取（用 LEFT JOIN：
            task_config_id=0 是「还没匹配到任何配置就被拒」的哨兵值，INNER JOIN 会把它整类吃掉。
            不过一旦按活动筛，丢掉这类无归属流水本来就是对的）；
          · 时间窗借用「开始时间」那一段，落到 f.create_time 上 —— 两者不是同一个口径
            （一个是任务的生效起点、一个是事件发生时刻），但运营要问的是「这段时间里
            事件为什么没转化成进度」，按同一段窗口对齐才答得上来。
        ⚠️ 结束日必须用 &lt; 次日零点：create_time 带时分秒，写 &lt;= '2026-08-16'
        会把 8/16 当天白天的流水全筛掉（valid_start_time 多是整点零时，才容得下 &lt;=）。
    -->
    <select id="selectDiscardStat" resultType="java.util.Map">
        SELECT f.discard_code AS discardCode, COUNT(*) AS discardCount
        FROM t_task_record_flow f
        <if test="queryForm.activityCode != null">
            LEFT JOIN t_task_config c ON c.id = f.task_config_id
        </if>
        <where>
            AND f.flow_type = 2
            <if test="queryForm.memberId != null">
                AND f.member_id = #{queryForm.memberId}
            </if>
            <if test="queryForm.activityCode != null">
                AND c.activity_code = #{queryForm.activityCode}
            </if>
            <if test="queryForm.validStartTimeBegin != null">
                AND f.create_time &gt;= #{queryForm.validStartTimeBegin}
            </if>
            <if test="queryForm.validStartTimeEnd != null">
                AND f.create_time &lt; DATE_ADD(#{queryForm.validStartTimeEnd}, INTERVAL 1 DAY)
            </if>
        </where>
        GROUP BY f.discard_code
        ORDER BY discardCount DESC
    </select>

    <!--
        ⚠️ 列一律带 r. 前缀：列表查询 join 了 t_member，而两张表都有
        status / create_by / create_time / update_by / update_time / member_id ——
        不加前缀 MySQL 直接报 Column 'status' in where clause is ambiguous。
    -->
    <sql id="query_conditions">
        <where>
                        <if test="queryForm.memberId != null">
                            AND r.member_id = #{queryForm.memberId}
                        </if>
                        <if test="queryForm.activityCode != null">
                            AND r.activity_code = #{queryForm.activityCode}
                        </if>
                        <if test="queryForm.validStartTimeBegin != null">
                            AND r.valid_start_time &gt;= #{queryForm.validStartTimeBegin}
                        </if>
                        <if test="queryForm.validStartTimeEnd != null">
                            <!-- 结束日含当天：这里是 LocalDate，绑进来是当天零点，写 &lt;= 会把结束日整天静默筛掉 -->
                            AND r.valid_start_time &lt; DATE_ADD(#{queryForm.validStartTimeEnd}, INTERVAL 1 DAY)
                        </if>
                        <if test="queryForm.status != null">
                            AND r.status = #{queryForm.status}
                        </if>
                        <if test="queryForm.completeTimeBegin != null">
                            AND r.complete_time &gt;= #{queryForm.completeTimeBegin}
                        </if>
                        <if test="queryForm.completeTimeEnd != null">
                            <!-- 结束日含当天：这里是 LocalDate，绑进来是当天零点，写 &lt;= 会把结束日整天静默筛掉 -->
                            AND r.complete_time &lt; DATE_ADD(#{queryForm.completeTimeEnd}, INTERVAL 1 DAY)
                        </if>
        </where>
    </sql>

    <!--
        列表页要显示会员账号，而任务记录表<b>没有</b>这一列（状态表不留快照，见 TaskRecord 类注释），
        所以 join 会员主表取当前值。

        🔴 必须 LEFT JOIN：会员被清理/注销后 t_member 查不到，INNER JOIN 会让这个人的任务记录
        整片从列表里消失 —— 记录还在库里、页面上却看不见，而且不报错。
    -->
    <sql id="list_columns">
                r.id,
                r.member_id,
                m.member_name,
                r.task_config_id,
                r.activity_code,
                r.period_key,
                r.valid_start_time,
                r.valid_end_time,
                r.current_metric,
                r.status,
                r.progress_data,
                r.rule_snapshot,
                r.prize_snapshot,
                r.complete_time,
                r.create_by,
                r.create_time,
                r.update_by,
                r.update_time
    </sql>

    <select id="queryPage" resultMap="TaskRecordDTO">
        SELECT
        <include refid="list_columns"/>
        FROM t_task_record r
        LEFT JOIN t_member m ON m.member_id = r.member_id
        <include refid="query_conditions"/>
        ORDER BY r.create_time DESC
    </select>

    <select id="queryList" resultMap="TaskRecordDTO">
        SELECT
        <include refid="list_columns"/>
        FROM t_task_record r
        LEFT JOIN t_member m ON m.member_id = r.member_id
        <include refid="query_conditions"/>
        ORDER BY r.create_time DESC
    </select>

                <delete id="batchDelete">
                    delete from t_task_record
                    where id in
                    <foreach collection="idList" open="(" close=")" separator="," item="item">
                        #{item}
                    </foreach>
                </delete>
                <delete id="deleteById">
                    delete from t_task_record
                        where id = #{id}
                </delete>

    <!-- ==================== 运行态（v3.44.0，方案 §4.4） ==================== -->

    <select id="selectByUniqueKey" resultType="solvela.task.TaskRecord">
        SELECT id, member_id, task_config_id, activity_code, period_key,
               valid_start_time, valid_end_time, current_metric, version, status,
               progress_data, rule_snapshot, prize_snapshot, complete_time,
               create_by, create_time, update_by, update_time
        FROM t_task_record
        WHERE member_id = #{memberId}
          AND task_config_id = #{taskConfigId}
          AND period_key = #{periodKey}
    </select>

    <!--
      取该基础周期下最新的一轮（limit_count 轮次用）。
      第 1 轮是裸键、第 2 轮起是「基础键#N」，所以两种形态都要匹配。
      按 id 倒序：轮次依次创建，id 最大的就是最新一轮。
    -->
    <select id="selectLatestRoundByPeriod" resultType="solvela.task.TaskRecord">
        SELECT id, member_id, task_config_id, activity_code, period_key,
               valid_start_time, valid_end_time, current_metric, version, status,
               progress_data, rule_snapshot, prize_snapshot, complete_time,
               create_by, create_time, update_by, update_time
        FROM t_task_record
        WHERE member_id = #{memberId}
          AND task_config_id = #{taskConfigId}
          AND (period_key = #{basePeriodKey} OR period_key LIKE CONCAT(#{basePeriodKey}, '#%'))
        ORDER BY id DESC
        LIMIT 1
    </select>

    <!--
      条件更新原子累加（COUNT / AMOUNT / SIMPLE）。
      把累加压进 UPDATE，靠行锁天然串行 —— 不会有 Lost Update，也不需要版本号和重试。
      rows=0 的语义是「任务已不在进行中」，不是并发冲突。
    -->
    <update id="advanceMetric">
        UPDATE t_task_record
        SET current_metric = current_metric + #{delta}
        WHERE id = #{id} AND status = 0
    </update>

    <!--
      乐观锁覆写（STREAK 专用）：断档要清零，必须先读后算，读-改-写无法避免。
      rows=0 = 版本已变或状态已流转，由调用方有限次重试。
    -->
    <update id="overwriteMetric">
        UPDATE t_task_record
        SET current_metric = #{metric},
            progress_data  = #{progressData},
            version        = version + 1
        WHERE id = #{id} AND status = 0 AND version = #{version}
    </update>

    <!--
      达标闸门：0-进行中 -> 1-已完成。
      complete_time 必须显式写 now()：这一列没有 ON UPDATE 兜底（铁律 9 的例外分支，
      与 approve_time / first_review_time 同类）。
    -->
    <update id="markCompleted">
        UPDATE t_task_record
        SET status = 1, complete_time = now()
        WHERE id = #{id} AND status = 0
    </update>

    <update id="markDispatched">
        UPDATE t_task_record
        SET status = 2
        WHERE id = #{id} AND status = 1
    </update>

    <!-- 只更新展示用的 progress_data，不碰 current_metric / status -->
    <update id="updateProgressData">
        UPDATE t_task_record
        SET progress_data = #{progressData}
        WHERE id = #{id}
    </update>

    <!-- 数据库时钟（铁律 9） -->
    <select id="selectDbNow" resultType="java.time.LocalDateTime">
        SELECT now()
    </select>

    <!--
        ==================== 过期收口（taskRecordExpire 定时任务） ====================

        idx_t_tsk_rec_expire(status, valid_end_time) 这个索引本来就是给这个扫描建的，
        只是扫描一直没写 —— 于是过了有效期的记录永远停在「进行中」，
        用户端一直看到一个永远完不成的任务，达标率的分母里也一直混着这批僵尸记录。

        ⚠️ now 由任务上下文传入（数据库时钟，铁律 9），这里不写 now()。
    -->
    <select id="countExpirableRecord" resultType="long">
        SELECT COUNT(*) FROM t_task_record
        WHERE status = 0 AND valid_end_time &lt; #{now}
    </select>

    <!--
        条件里只认 status = 0：幂等，且不会误伤已完成(1)/已发奖(2)的记录。
        LIMIT 分批，避免一次锁太多行。
    -->
    <update id="expireRecordBatch">
        UPDATE t_task_record
        SET status = 3
        WHERE status = 0 AND valid_end_time &lt; #{now}
        LIMIT #{limit}
    </update>

</mapper>
