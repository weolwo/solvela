<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.draw.poolconfig.dao.PrizePoolConfigDao">

    <resultMap id="PrizePoolConfigDTO" type="solvela.draw.poolconfig.domain.dto.PrizePoolConfigDTO">
            <result column="id" property="id" />
            <result column="activity_code" property="activityCode" />
            <result column="pool_code" property="poolCode" />
            <result column="pool_name" property="poolName" />
            <result column="status" property="status" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                activity_code, 
                pool_code, 
                pool_name,
                status, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.activityCode != null">
                            AND activity_code = #{queryForm.activityCode}
                        </if>
                        <if test="queryForm.poolCode != null">
                            AND pool_code = #{queryForm.poolCode}
                        </if>
                        <if test="queryForm.poolName != null">
                            AND pool_name = #{queryForm.poolName}
                        </if>
                        <if test="queryForm.status != null">
                            AND status = #{queryForm.status}
                        </if>
                        <if test="queryForm.createTimeBegin != null">
                            AND create_time &gt;= #{queryForm.createTimeBegin}
                        </if>
                        <if test="queryForm.createTimeEnd != null">
                            <!-- 结束日含当天：这里是 LocalDate，绑进来是当天零点，写 &lt;= 会把结束日整天静默筛掉 -->
                            AND create_time &lt; DATE_ADD(#{queryForm.createTimeEnd}, INTERVAL 1 DAY)
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="PrizePoolConfigDTO">
        SELECT
        <include refid="base_columns"/>
        FROM t_prize_pool_config
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="PrizePoolConfigDTO">
        SELECT
        <include refid="base_columns"/>
        FROM t_prize_pool_config
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

                <delete id="batchDelete">
                    delete from t_prize_pool_config
                    where id in
                    <foreach collection="idList" open="(" close=")" separator="," item="item">
                        #{item}
                    </foreach>
                </delete>
                <delete id="deleteById">
                    delete from t_prize_pool_config
                        where id = #{id}
                </delete>

    <!--
        奖池开关的条件更新。WHERE status = #{from} 是并发闸门：
        两个运营同时点禁用，第二个人 rows=0，不会出现「都以为自己成功了」。
        与 LotteryConfigMapper.updateStatus 同构。
    -->
    <update id="updateStatus">
        UPDATE t_prize_pool_config
        SET status = #{to}
        WHERE id = #{id}
          AND status = #{from}
    </update>

</mapper>