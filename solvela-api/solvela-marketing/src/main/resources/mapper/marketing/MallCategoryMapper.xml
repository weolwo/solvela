<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.mall.category.dao.MallCategoryDao">

    <resultMap id="MallCategoryDTO" type="solvela.mall.category.domain.dto.MallCategoryDTO">
            <result column="id" property="id" />
            <result column="parent_id" property="parentId" />
            <result column="category_name" property="categoryName" />
            <result column="icon_file_id" property="iconFileId" />
            <result column="sort" property="sort" />
            <result column="status" property="status" />
            <result column="commodity_count" property="commodityCount" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                parent_id, 
                category_name, 
                icon_file_id, 
                sort, 
                status, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.categoryName != null and queryForm.categoryName != ''">
                            AND category_name LIKE CONCAT('%', #{queryForm.categoryName}, '%')
                        </if>
                        <if test="queryForm.status != null">
                            AND status = #{queryForm.status}
                        </if>
                        <if test="queryForm.createBy != null">
                            AND create_by = #{queryForm.createBy}
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="MallCategoryDTO">
        SELECT
        <include refid="base_columns"/>
        FROM t_mall_category
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <!-- 下拉/宫格按运营设定的顺序展示，走 idx_mall_cat_status_sort -->
    <!--
      商品数走子查询而不是 LEFT JOIN + GROUP BY：后者会让分类行按商品数膨胀，
      再靠 GROUP BY 收回来，分页的 limit 就作用在膨胀后的结果集上了。
      分类量级在几十，这个子查询走 idx_mall_cmd_cat_status_sort，开销可以忽略。
    -->
    <sql id="commodity_count">
        (SELECT COUNT(1) FROM t_mall_commodity mc WHERE mc.category_id = t_mall_category.id) AS commodity_count
    </sql>

    <select id="queryList" resultMap="MallCategoryDTO">
        SELECT
        <include refid="base_columns"/>,
        <include refid="commodity_count"/>
        FROM t_mall_category
        <include refid="query_conditions"/>
        ORDER BY sort ASC, id ASC
    </select>

                <delete id="batchDelete">
                    delete from t_mall_category
                    where id in
                    <foreach collection="idList" open="(" close=")" separator="," item="item">
                        #{item}
                    </foreach>
                </delete>
                <delete id="deleteById">
                    delete from t_mall_category
                        where id = #{id}
                </delete>

</mapper>