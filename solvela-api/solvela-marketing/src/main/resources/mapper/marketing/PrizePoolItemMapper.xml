<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.draw.poolitem.dao.PrizePoolItemDao">

    <resultMap id="PrizePoolItemDTO" type="solvela.draw.poolitem.domain.dto.PrizePoolItemDTO">
            <result column="id" property="id" />
            <result column="activity_code" property="activityCode" />
            <result column="prize_code" property="prizeCode" />
            <result column="user_max_count" property="userMaxCount" />
            <result column="total_stock" property="totalStock" />
            <result column="used_stock" property="usedStock" />
            <result column="white_list" property="whiteList" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                activity_code, 
                prize_code, 
                user_max_count, 
                total_stock, 
                used_stock, 
                white_list, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.activityCode != null">
                            AND activity_code = #{queryForm.activityCode}
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="PrizePoolItemDTO">
        SELECT
        <include refid="base_columns"/>
        FROM t_prize_pool_item
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="PrizePoolItemDTO">
        SELECT
        <include refid="base_columns"/>
        FROM t_prize_pool_item
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

                <delete id="batchDelete">
                    delete from t_prize_pool_item
                    where id in
                    <foreach collection="idList" open="(" close=")" separator="," item="item">
                        #{item}
                    </foreach>
                </delete>
                <delete id="deleteById">
                    delete from t_prize_pool_item
                        where id = #{id}
                </delete>

    <!-- 已发库存+1（防超发第二道防线）：不限量(-1)或未发满才更新，返回0=DB层面无库存 -->
    <update id="increaseUsedStock">
        UPDATE t_prize_pool_item
        SET used_stock = used_stock + 1, version = version + 1
        WHERE id = #{id} AND (total_stock = -1 OR used_stock &lt; total_stock)
    </update>

    <!-- 奖池重置周期的计数桶按它计算，全系统只认数据库一个时钟（铁律 9/10） -->
    <select id="selectDbNow" resultType="java.time.LocalDateTime">
        SELECT NOW()
    </select>

</mapper>