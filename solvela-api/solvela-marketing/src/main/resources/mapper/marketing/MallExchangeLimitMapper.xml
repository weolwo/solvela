<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="solvela.mall.exchangelimit.dao.MallExchangeLimitDao">

    <resultMap id="MallExchangeLimitVO" type="solvela.mall.exchangelimit.domain.vo.MallExchangeLimitVO">
            <result column="id" property="id" />
            <result column="member_id" property="memberId" />
            <result column="commodity_id" property="commodityId" />
            <result column="period_key" property="periodKey" />
            <result column="used_count" property="usedCount" />
            <result column="create_time" property="createTime" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                member_id, 
                commodity_id, 
                period_key, 
                used_count, 
                create_time, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.memberId != null">
                            AND member_id = #{queryForm.memberId}
                        </if>
                        <if test="queryForm.commodityId != null">
                            AND commodity_id = #{queryForm.commodityId}
                        </if>
                        <if test="queryForm.createTimeBegin != null">
                            AND create_time &gt;= #{queryForm.createTimeBegin}
                        </if>
                        <if test="queryForm.createTimeEnd != null">
                            AND create_time &lt;= #{queryForm.createTimeEnd}
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="MallExchangeLimitVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_mall_exchange_limit
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="MallExchangeLimitVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_mall_exchange_limit
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

                <delete id="batchDelete">
                    delete from t_mall_exchange_limit
                    where id in
                    <foreach collection="idList" open="(" close=")" separator="," item="item">
                        #{item}
                    </foreach>
                </delete>
                <delete id="deleteById">
                    delete from t_mall_exchange_limit
                        where id = #{id}
                </delete>

</mapper>