<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ⚠️ 前缀是 solvela 而 parent 仍是 solvela-parent，这是【故意】的，不是漏改：
         老模块（solvela-admin / solvela-base / solvela-marketing / common-api）沿用 Solvela 的 sa- 前缀不动，
         新模块用自己的品牌前缀。两套前缀在同一个 Maven 反应堆里共存完全正常 ——
         parent 提供的是 dependencyManagement 与 build 约定，与 groupId 叫什么无关。 -->
    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>solvela</groupId>
    <artifactId>solvela-app</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>solvela-app</name>
    <description>solvela C 端应用服务（H5 / 小程序 / App 共用一套接口）</description>

    <dependencies>

        <!-- 枚举与错误码。本模块直接用到的只有 solvela.code.ErrorCode 与 solvela.enums.*，
             都在 contract 里 —— 2026-08-30 把 solvela-model 摘掉了：网关不再碰任何实体。

             ⚠️ 说实话：mybatis-plus-core 仍会经 base-core → solvela-model 传递进来。
             真正有意义的那条线是「没有驱动、没有数据源、没有 Mapper」，
             由 AppBoundaryTest 的 Class.forName 断言守着 ——
             没有驱动的 ORM 核心是一堆用不上的类，不是一条能连库的路。 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-contract</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!--
        直接依赖 web 栈，<b>不经过 solvela-web</b>。
        solvela-web 是管理端的 HTTP 层：它带着 knife4j 与管理端的鉴权注解，
        以及一个一律返回 200 + ResponseDTO 的全局异常处理器 —— 那套契约与本进程冲突。
        本模块自己写 TraceFilter / ApiExceptionHandler / ClientIp，共十来个类，
        换来的是「C 端的 HTTP 行为只有一个地方定义」。
        -->
        <!-- 链路 id 过滤器（solvela.base.web.TraceFilter）。它与
             DownstreamClientConfig 的请求头拦截器是一件事的两半 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-web</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
        接口文档。与管理端同一套（knife4j -> springdoc），前端两边看到的形态一致。
        生产包会把整套文档依赖排出 BOOT-INF/lib（见下面 prod profile 的 excludes，约 5.9MB）。

        本模块<b>不写 @Operation</b>：方法上的 javadoc 就是接口描述，
        由 therapi 在编译期编进资源、springdoc 在运行期读出来。
        一份注释同时给读代码的人和看文档的人，不会两份各自过期。
        -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
        </dependency>


        <!-- 网关只直接依赖这两块：工具/JSON/校验/链路 id（core）与会话存储要的 Redis。
             🔴 刻意【不写】 solvela-base 那个门面，也不写 solvela-base-data ——
             目标是 classpath 上连 mysql 驱动都没有。

             ⚠️ 今天还没达成：JDBC 仍经 solvela-member 传递进来（会员域有 MyBatis Dao，
             而它的 bean 目前与网关同进程）。等第 6 步把下面那条 solvela-member 依赖删掉，
             这个目标才真正成立，那时才能给 AppBoundaryTest 加上
             「Class.forName("com.mysql.cj.jdbc.Driver") 应当抛异常」这条断言。 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-core</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-redis</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 两个下游服务的【契约】：只有接口 + record，没有实现。
             实现由 HttpServiceProxyFactory 在运行期生成成 HTTP 代理（见 DownstreamClientConfig）。
             🔴 这里没有任何域实现模块 —— Maven 就是那道边界，后台 service 连 classpath 都上不来 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-marketing-api</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 会话：签发/解析/吊销令牌。只用 Redis，不带 JDBC —— 这正是它被拆出来的原因 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member-session</artifactId>
            <version>3.0.0</version>
        </dependency>

        

        <!-- provided：编译期注解处理器，不进运行包。provided 不传递，每个模块各自声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>solvela.app.AppApplication</mainClass>
                    <!-- repackage 默认把 provided 也打进 BOOT-INF/lib，光把 lombok 改成 provided 不够。
                         spring-boot-starter-parent 自带这条默认配置，本项目走 BOM import 没有继承到。 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 生产包：把整套 API 文档依赖排出 BOOT-INF/lib（约 5.9MB）。
             与 solvela-admin/pom.xml 的 prod profile 完全同构，改动时两边一起改。
             编译期这些 jar 仍在 classpath 上，只是不进生产包；运行期由
             SwaggerConfig 的 @Conditional 与 prod/solvela-base.yaml 的 enabled:false 兜底。 -->
        <profile>
            <id>prod</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>solvela.app.AppApplication</mainClass>
                            <excludes>
                                <exclude>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </exclude>
                                <!-- knife4j -->
                                <exclude>
                                    <groupId>com.baizhukui</groupId>
                                    <artifactId>knife4j-core</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.baizhukui</groupId>
                                    <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.baizhukui</groupId>
                                    <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.baizhukui</groupId>
                                    <artifactId>knife4j-openapi3-ui</artifactId>
                                </exclude>
                                <!-- springdoc + swagger -->
                                <exclude>
                                    <groupId>org.springdoc</groupId>
                                    <artifactId>springdoc-openapi-starter-common</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>org.springdoc</groupId>
                                    <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>org.springdoc</groupId>
                                    <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>org.webjars</groupId>
                                    <artifactId>swagger-ui</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>io.swagger.core.v3</groupId>
                                    <artifactId>swagger-core-jakarta</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>io.swagger.core.v3</groupId>
                                    <artifactId>swagger-models-jakarta</artifactId>
                                </exclude>
                                <!-- Jackson 2：唯一来源是 swagger-core-jakarta，跟着一起走 -->
                                <exclude>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-core</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-databind</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                                    <artifactId>jackson-dataformat-yaml</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>com.fasterxml.jackson.datatype</groupId>
                                    <artifactId>jackson-datatype-jsr310</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
