<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>solvela-base</artifactId>
    <version>3.0.0</version>

    <name>solvela-base</name>
    <description>solvela-base project</description>

    <dependencies>
        <!-- 领域词汇（错误码 / 领域异常 / PII 加解密 / BaseEnum / entity）。
             方向是 base → model：技术底座可以用领域词汇，反过来不行 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-model</artifactId>
            <version>3.0.0</version>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <!-- ⚠️ Lettuce 排掉了（2.49MB）：Redis 连接工厂由 redisson-spring-data-41 提供的
                 RedissonConnectionFactory 承担，全量检索下来 Lettuce 一处没用，
                 LettuceConnectionConfiguration 是 @ConditionalOnClass(RedisClient) 的，类不在即不装配。
                 管理端的令牌存储（RedisTokenStore）走的也是 StringRedisTemplate → 同一个 RedissonConnectionFactory。
                 ⚠️ 不要顺手排 reactor-core：spring-data-redis 的响应式部分自己要用。 -->
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.lettuce</groupId>
                    <artifactId>lettuce-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 测试依赖必须锁在 test 作用域，否则 JUnit/Mockito/AssertJ 会被打进生产 jar。
             各模块若需要写单测，自行引入同一条（test 作用域），不要依赖本模块传递。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <!-- protobuf 只服务于 X DevAPI（mysqlx:// 协议），本项目走的是经典 JDBC，用不到 -->
            <exclusions>
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <exclusions>
                <exclusion>
                    <artifactId>error_prone_annotations</artifactId>
                    <groupId>com.google.errorprone</groupId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- provided：lombok 是纯编译期的注解处理器，之前漏写 scope 导致 1.95MB 被打进
             BOOT-INF/lib，还把 jdk.compiler 拽进了 JDK 模块图。
             provided 不传递，所以每个用 @Data 的模块都要各自声明一次。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>


        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- MP 3.5.13+ 起 starter 不再传递 extension（ServiceImpl/IService/分页插件所在模块），需显式引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>

        <dependency>
            <groupId>p6spy</groupId>
            <artifactId>p6spy</artifactId>
        </dependency>

        <!-- 🔻 optional：默认不进包，省 31 个 jar / 8.37MB。
             理由是 dev / test / pre / prod 四套配置的 file.storage.mode 全是 local，
             那两个 S3 Bean 挂着 @ConditionalOnProperty(havingValue="cloud")，从来没被实例化过。
             要用云存储：在业务模块 pom 里显式引一次（版本走 dependencyManagement，不用写 version）；
             忘了引而又配了 mode=cloud 时，FileCloudStorageMissingGuard 会在启动期把话说明白。

             ⚠️ 别把这 8.37MB 想成「排几个传递依赖」能解决：s3 一个 jar 就 4.38MB（全量 API 模型类），
             加上 sdk-core / regions / third-party-jackson-core，4 个 jar 占了 82%，其余 27 个全是几 KB 的 SPI 包。
             另外 apache5-client(81KB) 不值得换成 url-connection-client —— 它依赖的
             httpclient5 + httpcore5 已经随 s3 一起进/出包，排掉反而要多引一个 jar。

             ✅ netty-nio-client 这条 exclusion 要留着：只用同步 S3Client，S3AsyncClient 一处没用。
             注意 netty 本体不会消失，Redisson 与 Lettuce 还在用。 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>


        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>

        <!-- velocity（engine-core + tools-generic）已随代码生成器整体移交 solvela-admin。
             全项目只有代码生成器渲染 .vm 模板时用它，solvela-base 移交后一处都不用了
             （SolvelaBeanUtil 里只有一句提到 velocity 的注释，不是引用）。
             留在这里的代价是每个依赖 solvela-base 的服务都得背着它 —— solvela-app
             这种 C 端进程永远不会生成代码。 -->

        <dependency>
            <groupId>org.lionsoul</groupId>
            <artifactId>ip2region</artifactId>
        </dependency>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>

        <!-- SonicExcel 写引擎 -->
        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel</artifactId>
        </dependency>

        <!-- SonicExcel 读引擎。它会带进 aalto-xml，而 aalto 的 META-INF/services 会抢占
             JVM 全局 StAX 实现（影响 spring-core / spring-web / hibernate-validator /
             mysql-connector-j / tika-core / aws-query-protocol）——
             由 SonicStaxIsolation 拨回 JDK 实现，SonicStaxIsolationTest 是它的哨兵。
             另外它还会带进 commons-compress，所以第③档摘 POI 时这一条删不掉。 -->
        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel-reader</artifactId>
        </dependency>

        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <!-- 项目只用 Redisson 的同步 API（RLock / RScript / RTopic），RxJava 客户端一处没用。
                 Redisson 的自动配置里 redissonRxJava() 是 @ConditionalOnClass 的，排掉即不装配，
                 实测启动正常。
                 ⚠️ 不要顺手把 reactor-core 也排掉：它的真实来源是 spring-boot-starter-data-redis
                 （Lettuce 需要），从这里排属于无效配置。 -->
            <exclusions>
                <exclusion>
                    <groupId>io.reactivex.rxjava3</groupId>
                    <artifactId>rxjava</artifactId>
                </exclusion>
                <!-- byte-buddy 4.44MB：Redisson 只在 RLiveObject / RemoteService 的动态代理里用它，
                     本项目只用 RLock / RScript / RTopic，一处没碰。 -->
                <exclusion>
                    <groupId>net.bytebuddy</groupId>
                    <artifactId>byte-buddy</artifactId>
                </exclusion>
                <!-- kryo 及其 reflectasm / minlog / jodd-util 共 0.75MB：只服务 Kryo5Codec，
                     而 RedissonPasswordConfigurationCustomizer 已把 codec 换成 SmileJackson3Codec。 -->
                <exclusion>
                    <groupId>com.esotericsoftware</groupId>
                    <artifactId>kryo</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.jodd</groupId>
                    <artifactId>jodd-util</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Smile 二进制格式，配合 Redisson 的 SmileJackson3Codec。
             ⚠️ groupId 是 Jackson 3 的 tools.jackson.dataformat，不是 Jackson 2 的
             com.fasterxml.jackson.dataformat —— 后者会把整套 Jackson 2 运行时（2.36MB）
             拖进来和 Spring Boot 4 自带的 Jackson 3 并存。 -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-smile</artifactId>
            <!-- 不需要写 version，Spring Boot 的依赖池已经管理了它与当前环境匹配的版本 -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>

        <!--
        运行时读 javadoc：与 annotationProcessorPaths 里的 scribe 配对，
        缺了它 springdoc 的 SpringDocJavadocConfiguration 不会激活（@ConditionalOnClass）。
        -->
        <dependency>
            <groupId>com.github.therapi</groupId>
            <artifactId>therapi-runtime-javadoc</artifactId>
            <version>${therapi.version}</version>
        </dependency>


        <!--
        原来是 spring-boot-starter-web 顺带带进来的。摘掉 starter-web 之后必须显式声明：
        base 里的 JsonUtils、各种序列化器、SonicExcel 的转换都直接用 Jackson。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

    </dependencies>


</project>
