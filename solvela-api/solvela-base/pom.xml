<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>solvela</groupId>
    <artifactId>solvela-base</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>solvela-base</name>
    <description>基础设施合集：core + redis + data + file 的门面，本身不含任何代码。</description>

    <!--
    ⚠️ 本模块 2026-08-30 起【没有任何代码】，只是把拆出去的四个 base 模块聚在一起。

    <h3>为什么保留它</h3>
    拆分之前全仓十几个模块都写着 `solvela-base`。把它们一次性改成「各自列出真正需要的那几个」
    要动每一个 pom，而那类改动一旦漏一个就是编译失败 —— 收益却是零，因为大多数模块确实四个都要。
    所以留一个门面：**老的依赖声明原样有效**，需要收窄的模块（今天只有 solvela-app）
    自己改成显式依赖 core + redis。

    <h3>什么时候删掉它</h3>
    等每个模块都把依赖收窄到真正需要的那几个之后。在那之前，
    **新模块请直接依赖具体的那一个**，不要图省事写 solvela-base ——
    写了它就等于把 JDBC 驱动、S3 SDK、Excel 引擎一并背上。

    <h3>四个模块的分工</h3>
    <ul>
      <li>core —— 工具、JSON、校验、常量、链路 id、配置装载。谁都能依赖；</li>
      <li>redis —— 缓存、RedisService、Redisson、分布式锁；</li>
      <li>data —— MyBatis-Plus、数据源、p6spy、Dao 基类。<b>依赖它就等于有了 JDBC 驱动</b>；</li>
      <li>file —— 对象存储、文件模块、SonicExcel、邮件、模板。</li>
    </ul>
    -->
    <properties>
        <!-- 本模块没有任何源码，自然也没有测试。不关掉的话 surefire 会去找 junit3 provider
             （classpath 上一个测试框架都没有时的兜底），离线构建直接失败 -->
        <maven.test.skip>true</maven.test.skip>
    </properties>

    <dependencies>

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-core</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-redis</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-data</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-file</artifactId>
            <version>3.0.0</version>
        </dependency>

    </dependencies>

</project>
