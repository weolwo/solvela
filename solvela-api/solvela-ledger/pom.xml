<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>solvela-ledger</artifactId>
    <name>solvela-ledger</name>

    <!--
      账务：钱包、券、资产流水、实物履约。app 端「资产操作」的落点。

      【为什么是一个模块，而不是 common-api 里的一个包】
      同一个 jar 里的包之间可以随手互相引用，编译器不拦、code review 也未必看得出来 ——
      风控与账务此前就是这样长出了一个双向环，直到按域拆模块才暴露。
      模块的依赖列表是编译器在守的：本模块的 pom 里没写的东西，这里<b>引不进来</b>。

      <p>另一个看法：将来若真拆成独立服务，这些 dependency 就是那时的 RPC 调用方向。
      现在把方向定对，比那时再来理顺便宜得多。
    -->

    <dependencies>

        <!-- 派发结果要回给发奖侧：PrizeDispatchResultMessage 是会员服务对外的消息契约 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- 本模块直接用到 model 的实体 35 处。
             原来靠 base 传递过来 —— 用什么就声明什么，别指望别人替你带。 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-model</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- 基础设施。2026-08-31 起不再写 solvela-base 那个空门面（0 行代码），
             改成列出真正用到的那几块 —— 写门面等于把 JDBC 驱动、S3 SDK、Excel 引擎一并背上。
             归因：core 10 处、file 7 处（实物发货的凭证附件）、data 1 处；本模块有 4 个 Mapper.xml。
             不要 redis：一处都没用到 -->
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-core</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-data</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-file</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-member</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-prize</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-risk</artifactId>
            <version>3.0.0</version>
        </dependency>


        <!-- provided：编译期注解处理器，不进运行包。provided 不传递，每个模块各自声明 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
