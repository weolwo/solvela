<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>solvela</groupId>
        <artifactId>solvela-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>solvela</groupId>
    <artifactId>solvela-base-data</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>solvela-base-data</name>
    <description>基础设施-数据：MyBatis-Plus、数据源、p6spy、Dao 基类、自动填充、系统配置表。</description>

    <!--
    🔴 依赖这个模块 = classpath 上有 JDBC 驱动和整套 ORM，DataSource 自动配置也随之生效。
    C 端网关的目标恰恰是「连驱动都没有」，所以它不该依赖本模块 ——
    这条约束由 AppBoundaryTest 里的 Class.forName 断言守着。
    -->
    <dependencies>

        <dependency>
            <groupId>solvela</groupId>
            <artifactId>solvela-base-core</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- MP 3.5.13+ 起 starter 不再传递 extension（ServiceImpl/IService/分页插件所在模块），需显式引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <!-- protobuf 只服务于 X DevAPI（mysqlx:// 协议），本项目走的是经典 JDBC，用不到 -->
            <exclusions>
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>p6spy</groupId>
            <artifactId>p6spy</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
