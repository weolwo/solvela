<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sa.task.recordflow.dao.TaskRecordFlowDao">

    <resultMap id="TaskRecordFlow" type="sa.task.recordflow.domain.entity.TaskRecordFlow">
        <result column="id" property="id"/>
        <result column="member_id" property="memberId" />
        <result column="member_name" property="memberName"/>
        <result column="task_config_id" property="taskConfigId"/>
        <result column="record_id" property="recordId"/>
        <result column="event_code" property="eventCode"/>
        <result column="event_biz_id" property="eventBizId"/>
        <result column="flow_type" property="flowType"/>
        <result column="delta_metric" property="deltaMetric"/>
        <result column="after_metric" property="afterMetric"/>
        <result column="discard_code" property="discardCode"/>
        <result column="discard_reason" property="discardReason"/>
        <result column="event_payload" property="eventPayload"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="base_columns">
        id, member_id, member_name, task_config_id, record_id, event_code, event_biz_id,
        flow_type, delta_metric, after_metric, discard_code, discard_reason, event_payload,
        create_by, create_time, update_by, update_time
    </sql>

    <select id="selectByRecordId" resultMap="TaskRecordFlow">
        SELECT
        <include refid="base_columns"/>
        FROM t_task_record_flow
        WHERE record_id = #{recordId}
        ORDER BY id ASC
    </select>

</mapper>
