<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sa.mall.address.dao.MallAddressDao">

    <resultMap id="MallAddressVO" type="sa.mall.address.domain.vo.MallAddressVO">
            <result column="id" property="id" />
            <result column="member_id" property="memberId" />
            <result column="receiver_name" property="receiverName" />
            <result column="receiver_phone" property="receiverPhone" />
            <result column="detail_address" property="detailAddress" />
            <result column="province" property="province" />
            <result column="city" property="city" />
            <result column="district" property="district" />
            <result column="is_default" property="isDefault" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                member_id, 
                receiver_name, 
                receiver_phone, 
                detail_address, 
                province, 
                city, 
                district, 
                is_default, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
        </where>
    </sql>

    <select id="queryPage" resultMap="MallAddressVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_mall_address
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="MallAddressVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_mall_address
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>


</mapper>