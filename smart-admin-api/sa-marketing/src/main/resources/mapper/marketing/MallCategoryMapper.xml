<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sa.mall.category.dao.MallCategoryDao">

    <resultMap id="MallCategoryVO" type="sa.mall.category.domain.vo.MallCategoryVO">
            <result column="id" property="id" />
            <result column="parent_id" property="parentId" />
            <result column="category_name" property="categoryName" />
            <result column="icon_file_id" property="iconFileId" />
            <result column="sort" property="sort" />
            <result column="status" property="status" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                parent_id, 
                category_name, 
                icon_file_id, 
                sort, 
                status, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.categoryName != null">
                            AND category_name = #{queryForm.categoryName}
                        </if>
                        <if test="queryForm.createBy != null">
                            AND create_by = #{queryForm.createBy}
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="MallCategoryVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_mall_category
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="MallCategoryVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_mall_category
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

                <delete id="batchDelete">
                    delete from t_mall_category
                    where id in
                    <foreach collection="idList" open="(" close=")" separator="," item="item">
                        #{item}
                    </foreach>
                </delete>
                <delete id="deleteById">
                    delete from t_mall_category
                        where id = #{id}
                </delete>

</mapper>