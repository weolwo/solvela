<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sa.member.verify.dao.MemberVerifyDao">

    <resultMap id="MemberVerifyVO" type="sa.member.verify.domain.vo.MemberVerifyVO">
            <result column="id" property="id" />
            <result column="member_id" property="memberId" />
            <result column="real_name" property="realName" />
            <result column="id_card" property="idCard" />
            <result column="id_card_hash" property="idCardHash" />
            <result column="verify_status" property="verifyStatus" />
            <result column="verify_time" property="verifyTime" />
            <result column="fail_reason" property="failReason" />
            <result column="create_time" property="createTime" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                member_id, 
                real_name, 
                id_card, 
                id_card_hash, 
                verify_status, 
                verify_time, 
                fail_reason, 
                create_time, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.memberId != null">
                            AND member_id = #{queryForm.memberId}
                        </if>
                        <if test="queryForm.verifyStatus != null">
                            AND verify_status = #{queryForm.verifyStatus}
                        </if>
                        <if test="queryForm.createTimeBegin != null">
                            AND create_time &gt;= #{queryForm.createTimeBegin}
                        </if>
                        <if test="queryForm.createTimeEnd != null">
                            AND create_time &lt;= #{queryForm.createTimeEnd}
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="MemberVerifyVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_member_verify
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="MemberVerifyVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_member_verify
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>


</mapper>