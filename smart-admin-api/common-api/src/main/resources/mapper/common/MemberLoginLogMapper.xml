<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sa.member.loginlog.dao.MemberLoginLogDao">

    <resultMap id="MemberLoginLogVO" type="sa.member.loginlog.domain.vo.MemberLoginLogVO">
            <result column="id" property="id" />
            <result column="member_id" property="memberId" />
            <result column="client_ip" property="clientIp" />
            <result column="ip_region" property="ipRegion" />
            <result column="device_type" property="deviceType" />
            <result column="os_name" property="osName" />
            <result column="browser_name" property="browserName" />
            <result column="status" property="status" />
            <result column="remark" property="remark" />
            <result column="trace_id" property="traceId" />
            <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                member_id, 
                client_ip, 
                ip_region, 
                device_type, 
                os_name, 
                browser_name, 
                status, 
                remark, 
                trace_id, 
                create_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.memberId != null">
                            AND member_id = #{queryForm.memberId}
                        </if>
                        <if test="queryForm.clientIp != null">
                            AND client_ip = #{queryForm.clientIp}
                        </if>
                        <if test="queryForm.createTimeBegin != null">
                            AND create_time &gt;= #{queryForm.createTimeBegin}
                        </if>
                        <if test="queryForm.createTimeEnd != null">
                            AND create_time &lt;= #{queryForm.createTimeEnd}
                        </if>
                        <if test="queryForm.status != null">
                            AND status = #{queryForm.status}
                        </if>
                        <if test="queryForm.deviceType != null">
                            AND device_type = #{queryForm.deviceType}
                        </if>
                        <if test="queryForm.traceId != null">
                            AND trace_id = #{queryForm.traceId}
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="MemberLoginLogVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_member_login_log
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="MemberLoginLogVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_member_login_log
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>


</mapper>