<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sa.member.dao.MemberDao">

    <resultMap id="MemberVO" type="sa.member.domain.vo.MemberVO">
            <result column="member_id" property="memberId" />
            <result column="member_name" property="memberName" />
            <result column="name_update_time" property="nameUpdateTime" />
            <result column="nickname" property="nickname" />
            <result column="avatar_file_id" property="avatarFileId" />
            <result column="gender" property="gender" />
            <result column="birthday" property="birthday" />
            <result column="phone" property="phone" />
            <result column="phone_hash" property="phoneHash" />
            <result column="email" property="email" />
            <result column="email_hash" property="emailHash" />
            <result column="password" property="password" />
            <result column="status" property="status" />
            <result column="register_source" property="registerSource" />
            <result column="register_ip" property="registerIp" />
            <result column="invite_id" property="inviteId" />
            <result column="remark" property="remark" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                member_id, 
                member_name, 
                name_update_time, 
                nickname, 
                avatar_file_id, 
                gender, 
                birthday, 
                phone, 
                phone_hash, 
                email, 
                email_hash, 
                password, 
                status, 
                register_source, 
                register_ip, 
                invite_id, 
                remark, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.memberId != null">
                            AND member_id = #{queryForm.memberId}
                        </if>
                        <!-- 搜索框走模糊：精确等于的话运营得把账号一字不差地打出来 -->
                        <if test="queryForm.memberName != null and queryForm.memberName != ''">
                            AND member_name LIKE CONCAT('%', #{queryForm.memberName}, '%')
                        </if>
                        <if test="queryForm.nickname != null and queryForm.nickname != ''">
                            AND nickname LIKE CONCAT('%', #{queryForm.nickname}, '%')
                        </if>
                        <if test="queryForm.gender != null">
                            AND gender = #{queryForm.gender}
                        </if>
                        <if test="queryForm.status != null">
                            AND status = #{queryForm.status}
                        </if>
                        <if test="queryForm.registerSource != null and queryForm.registerSource != ''">
                            AND register_source = #{queryForm.registerSource}
                        </if>
                        <if test="queryForm.inviteId != null">
                            AND invite_id = #{queryForm.inviteId}
                        </if>
                        <if test="queryForm.createTimeBegin != null">
                            AND create_time &gt;= #{queryForm.createTimeBegin}
                        </if>
                        <!--
                          🔴 结束日期要用「< 次日零点」，不能用「<= 当天」。
                          createTimeEnd 是 LocalDate，绑进 datetime 列是当天 00:00:00 ——
                          写成 <= 的话「截止到 8/23」实际只能查到 8/23 00:00:00，
                          当天的记录一条都出不来。这类错不会报错，只会让人以为「今天没数据」。
                        -->
                        <if test="queryForm.createTimeEnd != null">
                            AND create_time &lt; DATE_ADD(#{queryForm.createTimeEnd}, INTERVAL 1 DAY)
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="MemberVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_member
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="MemberVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_member
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>


</mapper>