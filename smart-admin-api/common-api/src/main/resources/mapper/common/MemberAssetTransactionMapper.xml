<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sa.ledger.transaction.dao.MemberAssetTransactionDao">

    <resultMap id="MemberAssetTransactionVO" type="sa.ledger.transaction.domain.vo.MemberAssetTransactionVO">
            <result column="id" property="id" />
            <result column="tenant_id" property="tenantId" />
            <result column="member_name" property="memberName" />
            <result column="asset_type" property="assetType" />
            <result column="transaction_type" property="transactionType" />
            <result column="change_amount" property="changeAmount" />
            <result column="balance_after" property="balanceAfter" />
            <result column="biz_type" property="bizType" />
            <result column="biz_ref_id" property="bizRefId" />
            <result column="remark" property="remark" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                tenant_id, 
                member_name, 
                asset_type, 
                transaction_type, 
                change_amount, 
                balance_after, 
                biz_type, 
                biz_ref_id, 
                remark, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.tenantId != null">
                            AND tenant_id = #{queryForm.tenantId}
                        </if>
                        <if test="queryForm.memberName != null">
                            AND member_name = #{queryForm.memberName}
                        </if>
                        <if test="queryForm.assetType != null">
                            AND asset_type = #{queryForm.assetType}
                        </if>
                        <if test="queryForm.transactionType != null">
                            AND transaction_type = #{queryForm.transactionType}
                        </if>
                        <if test="queryForm.bizRefId != null">
                            AND biz_ref_id = #{queryForm.bizRefId}
                        </if>
                        <if test="queryForm.createTimeBegin != null">
                            AND create_time &gt;= #{queryForm.createTimeBegin}
                        </if>
                        <!--
                            ⚠️ 结束日必须用 &lt; 次日零点：createTimeEnd 是 LocalDate，
                            绑进来是当天 00:00:00，而 create_time 带时分秒 ——
                            原先的 &lt;= 会把结束日当天的流水整天筛掉，且没有任何报错。
                        -->
                        <if test="queryForm.createTimeEnd != null">
                            AND create_time &lt; DATE_ADD(#{queryForm.createTimeEnd}, INTERVAL 1 DAY)
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="MemberAssetTransactionVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_member_asset_transaction
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="MemberAssetTransactionVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_member_asset_transaction
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <!--
        原先这里有 batchDelete / deleteById 两条 DELETE FROM，已随写接口一起移除（v3.69.0）：
        账务与审计流水删掉就再也查不回来，事后连「少了什么」都不知道。
    -->

    <!--
        统计面板的时间窗，四个财务页面同一个写法。

        ⚠️ 两个日期都为 null 时用 CURDATE() 落到当天 —— 这就是「默认只统计当天」的实现处。
        刻意用数据库的 CURDATE() 而不是在 Java 里 LocalDate.now()：表里的时间列都是
        数据库时钟写的（铁律 9），两个钟不同区时「今天」会差出几个小时，而且不报错，
        只是数字悄悄少一截。

        ⚠️ jdbcType=DATE 不能省：允许传 null，MyBatis 拿到 null 又推断不出类型时会抛
        「JdbcType OTHER」，而这只在「用户不传日期」那一条路径上发生，点页面根本测不到。

        ⚠️ 结束日用 &lt; 次日零点，不是 &lt;= 当天：create_time 带时分秒，
        写 &lt;= 会把结束日当天的流水整天筛掉。
    -->
    <sql id="stat_window">
        AND create_time &gt;= COALESCE(#{form.statDateBegin,jdbcType=DATE}, CURDATE())
        AND create_time &lt; DATE_ADD(COALESCE(#{form.statDateEnd,jdbcType=DATE}, CURDATE()), INTERVAL 1 DAY)
    </sql>

    <!--
        总计 + 体检，一次扫表算完（不拆成多条 count：多次执行可能落在不同数据快照上，
        出现「分项加起来不等于总数」这种自相矛盾）。

        两个体检项都是「不该出现」的：
          - negativeBalanceCount  ：变动后余额为负。扣减走的是
            deductBalanceWithVersion（WHERE balance >= amount），正常扣不出负数，
            出现说明有人绕过钱包服务直接改了库，或者流水是手工插的；
          - nonPositiveChangeCount：change_amount 是「变动绝对值」，恒该 &gt; 0。
            出现 0 或负数说明写入侧把方向写进数值里了，那样收支两栏会同时错。
    -->
    <select id="selectStat" resultType="java.util.Map">
        SELECT
            COUNT(*)                                          AS txCount,
            COUNT(DISTINCT member_name)                       AS memberCount,
            COALESCE(SUM(biz_type = 'MANUAL_ADJUST'), 0)      AS manualAdjustCount,
            COALESCE(SUM(balance_after &lt; 0), 0)           AS negativeBalanceCount,
            COALESCE(SUM(change_amount &lt;= 0), 0)          AS nonPositiveChangeCount
        FROM t_member_asset_transaction
        <where><include refid="stat_window"/></where>
    </select>

    <!--
        按资产类型的收支。⚠️ 两件事不能省：
          · 必须按 asset_type 分组 —— 积分和现金不是同一个量纲；
          · 方向必须看 transaction_type —— change_amount 存的是绝对值，
            收入支出都是正数，直接 SUM(change_amount) 出来的数既不是收入也不是支出。

        钱包页面的「今日变动」直接调这一条，不另写一份：同一个口径两处实现早晚会漂。
    -->
    <select id="selectAssetFlowStat" resultType="java.util.Map">
        SELECT asset_type                                                                 AS assetType,
               COALESCE(SUM(transaction_type = 1), 0)                                     AS incomeCount,
               COALESCE(SUM(CASE WHEN transaction_type = 1 THEN change_amount END), 0)    AS incomeAmount,
               COALESCE(SUM(transaction_type = 2), 0)                                     AS expenseCount,
               COALESCE(SUM(CASE WHEN transaction_type = 2 THEN change_amount END), 0)    AS expenseAmount
        FROM t_member_asset_transaction
        <where><include refid="stat_window"/></where>
        GROUP BY asset_type
        ORDER BY asset_type
    </select>

    <!--
        业务类型分布，只给笔数不给金额：同一个 biz_type 下可能混着积分和现金，
        给金额就得再拆一层资产类型，页面上宽到没法看。与其给一个跨量纲相加的假金额，
        不如只给笔数 —— 这是刻意的取舍。

        biz_type 没有封闭字典（是 executeWalletDeduct/Refund 的入参，调用方随手传的字符串），
        所以原样分组、原样回显，不归类也不用「其它」盖住。
        LIMIT 10：没有字典约束，真乱起来会有很多值，不能让它把页面刷满。
    -->
    <select id="selectBizTypeStat" resultType="java.util.Map">
        SELECT biz_type                   AS bizType,
               COUNT(*)                   AS txCount,
               COUNT(DISTINCT member_name) AS memberCount
        FROM t_member_asset_transaction
        <where><include refid="stat_window"/></where>
        GROUP BY biz_type
        ORDER BY txCount DESC
        LIMIT 10
    </select>

</mapper>
