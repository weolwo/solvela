<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sa.ledger.logistic.dao.PhysicalDeliveryDao">

    <resultMap id="PhysicalDeliveryVO" type="sa.ledger.logistic.domain.vo.PhysicalDeliveryVO">
            <result column="id" property="id" />
            <result column="member_id" property="memberId" />
            <result column="member_name" property="memberName" />
            <result column="proposal_id" property="proposalId" />
            <result column="source_type" property="sourceType" />
            <result column="receiver_name" property="receiverName" />
            <result column="receiver_phone" property="receiverPhone" />
            <result column="receiver_address" property="receiverAddress" />
            <result column="logistics_company" property="logisticsCompany" />
            <result column="logistics_no" property="logisticsNo" />
            <result column="status" property="status" />
            <result column="create_by" property="createBy" />
            <result column="create_time" property="createTime" />
            <result column="update_by" property="updateBy" />
            <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="base_columns">
                id, 
                member_id,
                member_name,
                proposal_id, 
                source_type, 
                receiver_name, 
                receiver_phone, 
                receiver_address, 
                logistics_company, 
                logistics_no, 
                status, 
                create_by, 
                create_time, 
                update_by, 
                update_time
    </sql>

    <sql id="query_conditions">
        <where>
                        <if test="queryForm.memberId != null">
                            AND member_id = #{queryForm.memberId}
                        </if>
                        <if test="queryForm.proposalId != null">
                            AND proposal_id = #{queryForm.proposalId}
                        </if>
                        <if test="queryForm.sourceType != null">
                            AND source_type = #{queryForm.sourceType}
                        </if>
                        <if test="queryForm.logisticsNo != null">
                            AND logistics_no = #{queryForm.logisticsNo}
                        </if>
                        <if test="queryForm.status != null">
                            AND status = #{queryForm.status}
                        </if>
                        <if test="queryForm.createTimeBegin != null">
                            AND create_time &gt;= #{queryForm.createTimeBegin}
                        </if>
                        <!--
                            ⚠️ 结束日必须用 &lt; 次日零点：createTimeEnd 是 LocalDate，
                            绑进来是当天 00:00:00，而 create_time 带时分秒 ——
                            原先的 &lt;= 会把结束日当天新建的履约单整天筛掉，且没有任何报错。
                        -->
                        <if test="queryForm.createTimeEnd != null">
                            AND create_time &lt; DATE_ADD(#{queryForm.createTimeEnd}, INTERVAL 1 DAY)
                        </if>
        </where>
    </sql>

    <select id="queryPage" resultMap="PhysicalDeliveryVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_physical_delivery
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <select id="queryList" resultMap="PhysicalDeliveryVO">
        SELECT
        <include refid="base_columns"/>
        FROM t_physical_delivery
        <include refid="query_conditions"/>
        ORDER BY create_time DESC
    </select>

    <delete id="discardBatchIds">
        update  t_physical_delivery set status=-1
        where status=0 and id in
        <foreach collection="idList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </delete>
    <delete id="discardById">
        update  t_physical_delivery set status=-1
            where id = #{id} and status=0
    </delete>

    <!--
        统计面板的时间窗（本期新增，落在 create_time 上）。写法与另外三个财务页面一致：
        两个日期都为 null 时用数据库的 CURDATE() 落到当天（铁律 9：时间只认数据库一个钟）；
        jdbcType=DATE 不能省，否则传 null 时 MyBatis 会抛「JdbcType OTHER」；
        结束日用 &lt; 次日零点，写 &lt;= 会把结束日当天新建的履约单整天筛掉。
    -->
    <sql id="stat_window">
        AND create_time &gt;= COALESCE(#{form.statDateBegin,jdbcType=DATE}, CURDATE())
        AND create_time &lt; DATE_ADD(COALESCE(#{form.statDateEnd,jdbcType=DATE}, CURDATE()), INTERVAL 1 DAY)
    </sql>

    <!-- 本期新增的履约单 -->
    <select id="selectNewStat" resultType="java.util.Map">
        SELECT COUNT(*)                    AS newCount,
               COUNT(DISTINCT member_id) AS newMemberCount
        FROM t_physical_delivery
        <where><include refid="stat_window"/></where>
    </select>

    <!--
        履约状态与积压体检：⚠️ <b>刻意不带时间窗，统计的是全量</b>。
        积压是存量 —— 把它限制在今天，压了三天的那些单子会正好从页面上消失，
        而那恰恰是这个页面唯一需要有人动手的东西。

        待发货必须拆成两类，性质完全不同（DeliveryStatusEnum 的类注释也写了
        「要区分得看 receiver_address 是否为空，不是靠状态」）：
          - pendingNoAddressCount：收件信息没补全，<b>想发也发不了</b>，要去催用户；
          - 剩下的才是地址齐了、等着发的，那才是运营今天能干的活。
        实物是三段式履约：中奖时用户还没填地址，履约单先落、收件信息后补（见 v3.37.0.sql），
        所以 status=0 里天然混着这两种。

        末尾两个是一致性体检：
          - shippedNoLogisticsNo：已发货/已签收却没有物流单号 —— 用户查不到件，客服也查不到
          - returnedNoLogisticsNo：异常退回却没有物流单号 —— 退回这件事本身无从追溯

        ⚠️ status 还有一个 <b>-1</b>：页面上的「删除」其实是软作废，走 discardBatchIds
        （UPDATE ... SET status=-1 WHERE status=0）。这个取值<b>既不在 DDL 的列注释里，
        也不在 DeliveryStatusEnum 里</b>，只有前端字典认得它。
        这里必须单独给它一个桶，否则四个状态桶之和会小于总数，看的人只会以为统计算错了。
    -->
    <select id="selectStatusStat" resultType="java.util.Map">
        SELECT
            COUNT(*)                                                              AS totalCount,
            COALESCE(SUM(status = 0), 0)                                          AS pendingCount,
            COALESCE(SUM(status = 0
                     AND (receiver_name IS NULL OR receiver_name = ''
                       OR receiver_phone IS NULL OR receiver_phone = ''
                       OR receiver_address IS NULL OR receiver_address = '')), 0) AS pendingNoAddressCount,
            COALESCE(SUM(status = 1), 0)                                          AS deliveredCount,
            COALESCE(SUM(status = 2), 0)                                          AS signedCount,
            COALESCE(SUM(status = 3), 0)                                          AS returnedCount,
            COALESCE(SUM(status = -1), 0)                                         AS discardedCount,
            COALESCE(TIMESTAMPDIFF(MINUTE,
                     MIN(CASE WHEN status = 0 THEN create_time END), now()), 0)   AS pendingOldestMinutes,
            COALESCE(SUM(status IN (1, 2)
                     AND (logistics_no IS NULL OR logistics_no = '')), 0)         AS shippedNoLogisticsNo,
            COALESCE(SUM(status = 3
                     AND (logistics_no IS NULL OR logistics_no = '')), 0)         AS returnedNoLogisticsNo
        FROM t_physical_delivery
    </select>

    <!-- 来源维度分布，同样是全量：要处理的积压不分是今天来的还是上周来的 -->
    <select id="selectSourceStat" resultType="java.util.Map">
        SELECT source_type                        AS sourceType,
               COUNT(*)                           AS deliveryCount,
               COALESCE(SUM(status = 0), 0)       AS pendingCount,
               COALESCE(SUM(status IN (1, 2)), 0) AS shippedCount,
               COALESCE(SUM(status = -1), 0)      AS discardedCount
        FROM t_physical_delivery
        GROUP BY source_type
        ORDER BY deliveryCount DESC
    </select>

</mapper>
