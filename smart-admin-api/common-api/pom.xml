<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sa</groupId>
        <artifactId>sa-parent</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>common-api</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 本模块原先把 sa-base 的 40 条依赖整段抄了一遍，而它本来就 depend on sa-base，
         那些依赖全是 compile 作用域、本来就传递过来 —— 抄的那份对 classpath 一点影响没有，
         只是让「这里到底用了什么」彻底看不出来。现在只留本模块直接用到的，
         其余（spring / mybatis-plus / redisson / sa-token 等）继续走 sa-base 传递，
         与 sa-marketing 的写法保持一致。 -->
    <dependencies>
        <dependency>
            <groupId>sa</groupId>
            <artifactId>sa-base</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>


        <!-- scriptengine 规则引擎，全工程只有本模块用 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>qlexpress4</artifactId>
        </dependency>

        <!-- 测试依赖必须锁在 test 作用域，理由同 sa-base -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
