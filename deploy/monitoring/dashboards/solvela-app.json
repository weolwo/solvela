{
  "title": "Solvela 应用与中间件",
  "uid": "solvela-app",
  "tags": [
    "solvela"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "顶部「进程」下拉框可以切到单个进程（admin / app-gateway / app-biz）。MySQL 与 Redis 那几块不受它影响 —— 那是共享的中间件，不属于任何单个进程。 docker compose 与 k8s 共用同一份定义：deploy/monitoring/dashboards/solvela-app.json。",
  "panels": [
    {
      "type": "stat",
      "title": "MySQL 连接数",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "连接"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Redis 已用内存",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "已用"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MySQL QPS 与慢查询",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries[5m])",
          "legendFormat": "QPS"
        },
        {
          "expr": "rate(mysql_global_status_slow_queries[5m])",
          "legendFormat": "慢查询/秒"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redis 命中率与连接数",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / clamp_min(rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]), 0.001)",
          "legendFormat": "命中率"
        },
        {
          "expr": "redis_connected_clients",
          "legendFormat": "连接数"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM 堆（已用 / 上限）",
      "description": "app 这个标签来自 Prometheus 抓取配置里写的 labels，不依赖应用侧的 micrometer tag —— 少一层会变的东西。",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (app) (jvm_memory_used_bytes{app=~\"$app\", area=\"heap\"})",
          "legendFormat": "{{app}} 已用"
        },
        {
          "expr": "sum by (app) (jvm_memory_max_bytes{app=~\"$app\", area=\"heap\"})",
          "legendFormat": "{{app}} 上限"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC 暂停（每秒累计暂停时长）",
      "description": "不是单次暂停时长，是每秒花在 GC 暂停上的时间。接近 1 就说明这个进程基本在 GC 里过日子了。",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (app) (rate(jvm_gc_pause_seconds_sum{app=~\"$app\"}[5m]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP QPS（按进程）",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{app=~\"$app\"}[5m]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP P99 延迟",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (app, le) (rate(http_server_requests_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HikariCP 连接池",
      "description": "只有 admin 与 app-biz 有：网关 2026-09-01 摘掉了全部 base 模块，连 MySQL 驱动都没有，所以它不会出现在这块里。pending 持续大于 0 就是在等连接。",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "expr": "sum by (app) (hikaricp_connections_active{app=~\"$app\"})",
          "legendFormat": "{{app}} 活跃"
        },
        {
          "expr": "sum by (app) (hikaricp_connections_idle{app=~\"$app\"})",
          "legendFormat": "{{app}} 空闲"
        },
        {
          "expr": "sum by (app) (hikaricp_connections_pending{app=~\"$app\"})",
          "legendFormat": "{{app}} 等待中"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "进程",
        "description": "选 admin / app-gateway / app-biz 看单个进程，或 All 看全部。这个 app 标签来自 Prometheus 抓取配置里写死的 labels，compose 与 k8s 两边逐字一致。",
        "type": "query",
        "datasource": {
          "type": "prometheus"
        },
        "query": "label_values(jvm_memory_used_bytes, app)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  }
}
