{
  "title": "Solvela 应用与中间件",
  "uid": "solvela-app",
  "tags": [
    "solvela"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "顶部「进程」下拉框可以切到单个进程（admin / app-gateway / app-biz）。MySQL 与 Redis 那几块不受它影响 —— 那是共享的中间件，不属于任何单个进程。 docker compose 与 k8s 共用同一份定义：deploy/monitoring/dashboards/solvela-app.json。",
  "panels": [
    {
      "type": "stat",
      "title": "MySQL 连接数",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "连接"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Redis 已用内存",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "已用"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MySQL QPS 与慢查询",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries[5m])",
          "legendFormat": "QPS"
        },
        {
          "expr": "rate(mysql_global_status_slow_queries[5m])",
          "legendFormat": "慢查询/秒"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redis 命中率与连接数",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / clamp_min(rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]), 0.001)",
          "legendFormat": "命中率"
        },
        {
          "expr": "redis_connected_clients",
          "legendFormat": "连接数"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM 堆（已用 / 上限）",
      "description": "app 这个标签来自 Prometheus 抓取配置里写的 labels，不依赖应用侧的 micrometer tag —— 少一层会变的东西。",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (app) (jvm_memory_used_bytes{app=~\"$app\", area=\"heap\"})",
          "legendFormat": "{{app}} 已用"
        },
        {
          "expr": "sum by (app) (jvm_memory_max_bytes{app=~\"$app\", area=\"heap\"})",
          "legendFormat": "{{app}} 上限"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC 暂停（每秒累计暂停时长）",
      "description": "不是单次暂停时长，是每秒花在 GC 暂停上的时间。接近 1 就说明这个进程基本在 GC 里过日子了。",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (app) (rate(jvm_gc_pause_seconds_sum{app=~\"$app\"}[5m]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP QPS（按进程）",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{app=~\"$app\"}[5m]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP P99 延迟",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (app, le) (rate(http_server_requests_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HikariCP 连接池",
      "description": "只有 admin 与 app-biz 有：网关 2026-09-01 摘掉了全部 base 模块，连 MySQL 驱动都没有，所以它不会出现在这块里。pending 持续大于 0 就是在等连接。",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "expr": "sum by (app) (hikaricp_connections_active{app=~\"$app\"})",
          "legendFormat": "{{app}} 活跃"
        },
        {
          "expr": "sum by (app) (hikaricp_connections_idle{app=~\"$app\"})",
          "legendFormat": "{{app}} 空闲"
        },
        {
          "expr": "sum by (app) (hikaricp_connections_pending{app=~\"$app\"})",
          "legendFormat": "{{app}} 等待中"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "设计降级（每 5 分钟次数，按点位）",
      "description": "代码里 catch 住、不上抛、主流程照走的地方，每降级一次计一次（solvela_degraded_total）。点位含义见 solvela-contract 的 DegradePoint 枚举。正常时这里应当是空的或零星几点；某个点位持续出现就是有东西在悄悄失效 —— 尤其是 RISK_FAIL_OPEN / SECURITY_FAIL_OPEN（安全检查在放行）和 DRAW_* / PRIZE_*（钱和奖）。",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "expr": "sum by (app, point) (increase(solvela_degraded_total{app=~\"$app\"}[5m]))",
          "legendFormat": "{{app}} {{point}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "近 24 小时降级次数",
      "description": "按点位汇总的 24 小时次数，排在最前的就是最该先看的。计数器只在第一次降级时才出现，所以这里没有的点位就是 24 小时内一次都没降级过。",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 45
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (app, point) (increase(solvela_degraded_total{app=~\"$app\"}[24h])) > 0)",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "滑块验证码：出图与判题（每 5 分钟，按结果）",
      "description": "solvela_captcha_total。ISSUED 出图、PASSED 通过，其余是判题失败的几种（对客户端都是同一个 CAPTCHA_FAILED）：WRONG_POSITION 位置不对、TRACK_REJECTED 位置对但轨迹不像人、CHALLENGE_GONE 图过期或已验过或 id 是编的、MALFORMED 缺字段。含义见 CaptchaService.Outcome。MALFORMED / CHALLENGE_GONE 成片出现多半是脚本在直接打接口。",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(solvela_captcha_total{app=~\"$app\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "滑块通过率（通过 / 出图，15 分钟窗）",
      "description": "自建滑块挡不住专门针对它写的脚本，这条线是「被破了」的第一信号：真人的通过率相对稳定，通过率突然抬升且出图量同时放大，就是有脚本开始解得出图了。没有基线之前先观察，不设告警阈值。",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 54
      },
      "targets": [
        {
          "expr": "sum(increase(solvela_captcha_total{app=~\"$app\",outcome=\"PASSED\"}[15m])) / clamp_min(sum(increase(solvela_captcha_total{app=~\"$app\",outcome=\"ISSUED\"}[15m])), 1)",
          "legendFormat": "通过率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "type": "timeseries",
      "title": "滑块轨迹被拒原因（每 5 分钟）",
      "description": "solvela_captcha_track_rejected_total。位置拖对了、轨迹不像人：有人解出了图，还没学会装人手。原因含义见 TrackChecker.Reject。某个原因突然集中出现，先确认不是误伤真人（例如某类设备的 y 天然不抖），再决定是否收紧规则。",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 63
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(solvela_captcha_track_rejected_total{app=~\"$app\"}[5m])) > 0",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "滑块通行票核销（每 5 分钟，按结果）",
      "description": "solvela_captcha_ticket_total。CONSUMED 有效票被受保护接口核销；MISSING 没带票（发码时是还没拖的正常第一步，登录每个请求都核销所以不需要滑块的登录也落在这里，本身不是异常）；INVALID 带了过期、已用过或编造的票 —— 持续出现就是有人在重放或伪造通行票。「过了滑块但密码错」不在这里，查 t_member_risk_event 的 captcha_passed。",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 63
      },
      "targets": [
        {
          "expr": "sum by (result) (increase(solvela_captcha_ticket_total{app=~\"$app\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "进程",
        "description": "选 admin / app-gateway / app-biz 看单个进程，或 All 看全部。这个 app 标签来自 Prometheus 抓取配置里写死的 labels，compose 与 k8s 两边逐字一致。",
        "type": "query",
        "datasource": {
          "type": "prometheus"
        },
        "query": "label_values(jvm_memory_used_bytes, app)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  }
}
