NODE_ENV=production
VITE_APP_TITLE='Solvela V3.X'
# 🔴 相对路径，同源。2026-09-12 从 'https://preview.smartadmin.vip/smart-admin-api'
#    改过来 —— 那是上游模板的演示地址，照着它构建出来的管理端一上线就是全白。
#
# ⚠️ 只能填相对路径：pre / prod 【没有】CorsFilter（只在 dev/test 注册），
#    填成 https://api.xxx.com 这种跨域绝对地址，线上会全线 CORS 失败。
#    nginx 把静态站和 /api 放在同一个域下，就是为了这个。
VITE_APP_API_URL='/api'