# 复制成 .env 再改：cp .env.example .env
# ⚠️ .env 里是明文口令，务必确认它在 .gitignore 里，别提交。

# MySQL root 口令。库不对公网暴露（compose 里没有 ports 映射），
# 但仍然要设成随机长串 —— 同机上任何一个容器逃逸/被入侵都能直连它。
# 生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change-me-please

# Redis 口令。同上。
# ⚠️ 不要留空。留空时 Redisson 4 仍会发 AUTH，对无密码的 Redis 会报
#    "ERR Client sent AUTH, but no password is set" 直接启动失败。
REDIS_PASSWORD=change-me-too

# Redis 最大内存。放的是 Sa-Token 会话和分布式锁，量不大。
REDIS_MAXMEMORY=256mb

# 三个后端进程各自的内存上限。admin 实测稳态 529MB。
# 三个加起来约 2.8g，再加 MySQL(~400MB)、Redis、MinIO —— 建议机器有 6GB 以上。
# 内存紧张时先压 GATEWAY：它不连库，是三个里最轻的。
ADMIN_MEMORY=1g
GATEWAY_MEMORY=768m
BIZ_MEMORY=1g

# ⚠️ 这里【没有】对外端口配置项，是刻意的：所有服务都不发布端口，
#    外面唯一的入口是 cloudflared 隧道。详见 docker-compose.yml 开头。

# ─── 对象存储（MinIO）────────────────────────────────────────────────
# 图片和附件放这里。不用的话把 FILE_STORAGE_MODE 留成 local，
# 文件会写在 app 容器的 /home/solvela/upload —— 那样换机器/重建镜像图就没了。
#
# 生成：openssl rand -base64 24
MINIO_ROOT_USER=solvela
MINIO_ROOT_PASSWORD=change-me-as-well

# 桶名。建桶由 minio-init 那个一次性容器做，桶【保持私有】。
MINIO_BUCKET=solvela

# 🔴 真正的开关。改成 cloud 之后应用才会把文件写进 MinIO。
#    AWS S3 SDK 已经在 solvela-admin 的 pom 里引好了，直接改就行。
#
#    改成 cloud 之后，图片的 URL 形态【不变】：C 端仍然走
#    /support/file/public/<storageKey>，由后端从 MinIO 流出来。
#    所以桶可以一直保持私有，前端一行都不用动。
FILE_STORAGE_MODE=local


# ─── 密钥。这四把【必填】，缺一个应用就起不来 ──────────────────────────
#
# 为什么不给默认值：给了的话，忘配的人会用一个「全世界都知道的密钥」
# 把用户地址加密进库、给设备签名 —— 功能完全正常，而整套设计赖以成立的前提
# 直接归零，且没有任何迹象。宁可启动就失败。
#
# 四把一次生成：
#     for i in 1 2 3 4; do openssl rand -base64 30 | tr -d '/+=' | cut -c1-40; done
#
# 🔴 已经有生产数据的话【不要】随手换新值，先看清楚每一把能不能改。

# 个人信息字段级加密（收件人姓名/电话/详细地址）。
# 🔴 加密过之后就不能改 —— 改了旧数据全部解不开（AES-GCM 会认证失败并抛异常，
#    不会静默解出乱码，这是好事）。
SOLVELA_CRYPTO_PII_SECRET_KEY=change-me-1

# 手机号/邮箱的检索摘要。
# 🔴 比上面那把【更改不得】：上面那把还能「旧钥解、新钥写」迁移，这把一改，
#    老会员的手机号就查不出来了 —— 表现是他能用同一个号再注册一个新账号。
# ⚠️ 它泄露的后果是手机号能被离线穷举反查（号码全集只有 10^8 量级），
#    所以【不要和数据库备份放在同一个地方】。
SOLVELA_CRYPTO_PII_HMAC_KEY=change-me-2

# 会员号的置换密钥（内部序号 -> 10 位会员号）。
# 🔴 上线发过号之后不能改 —— 改了等于换一套映射，新号可能撞上已发出去的老号。
SOLVELA_MEMBER_ID_SECRET_KEY=change-me-3

# 设备令牌签名。
# 🔴 这把【必须能换】（泄露 = 任何人都能自签一个合法设备号），
#    和上面几把「永远不能改」的正好相反，所以刻意不共用。
# ⚠️ 三个后端进程验的是同一批令牌，必须逐字一致 —— compose 里用锚点保证了这点。
SOLVELA_AUTH_DEVICE_KEY_V1=change-me-4

# ─── 发信（SMTP）────────────────────────────────────────────────────
#
# 🔴 Cloudflare Email Routing 只能【收】信，不能发。
#    它让 xxx@taozicn.me 转发到你的私人邮箱 —— 很有用，但注册验证码是要
#    【发出去】的，那需要一个真正的 SMTP 服务商。
#
# 常见选择：Resend / Brevo / Mailgun / SendGrid / 阿里云邮推，
# 或者直接用 Gmail、163 的「应用专用密码」（个人量级够用）。
#
# 不填也能启动，但发验证码时会在运行时失败（报错明确，不是静默）。
# 这与上面那四把密钥的取舍相反：发不出邮件不该让整个后台起不来，
# 而密钥用错默认值是【静默】的灾难。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── 域名 ──────────────────────────────────────────────────────────
#
# ⚠️ 域名本身写在 deploy/cloudflared/config.yml 里（那是唯一一处）。
#    这里只有一个必须知道域名的后端配置项：
#
# C 端图片的 URL 前缀。桶是私有的，图片由 admin 进程从 MinIO 流出来，
# 所以填的是【C 端自己的域名】+ 那个免登录端点，不是 MinIO 地址。
# 🔴 留空的话所有图片会退回要登录态的下载接口 ——
#    管理端还能看图（带 token 取字节），C 端会全是叉。
FILE_STORAGE_PUBLIC_URL_PREFIX=https://app.taozicn.me/support/file/public/
