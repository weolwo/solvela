# 复制成 .env 再改：cp .env.example .env
# ⚠️ .env 里是明文口令，务必确认它在 .gitignore 里，别提交。

# MySQL root 口令。库不对公网暴露（compose 里没有 ports 映射），
# 但仍然要设成随机长串 —— 同机上任何一个容器逃逸/被入侵都能直连它。
# 生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change-me-please

# Redis 口令。同上。
# ⚠️ 不要留空。留空时 Redisson 4 仍会发 AUTH，对无密码的 Redis 会报
#    "ERR Client sent AUTH, but no password is set" 直接启动失败。
REDIS_PASSWORD=change-me-too

# Redis 最大内存。放的是 Sa-Token 会话和分布式锁，量不大。
REDIS_MAXMEMORY=256mb

# 应用对外端口。上了 nginx/caddy 反代之后建议改成只绑回环，
# 即把 docker-compose.yml 里的映射改成 "127.0.0.1:1024:1024"。
APP_PORT=1024

# 应用内存上限。实测稳态 529MB，1g 够用；2GB 的机器上可以给到 1200m。
APP_MEMORY=1g
